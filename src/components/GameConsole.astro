---
import FlowDiagram from './FlowDiagram.astro';
---
<div class="console-viewport">
<section id="gc">
  <img class="console-base" src="/Q_polar/console-base.png" alt="" />
  <div class="screen">
    <FlowDiagram />
  </div>
  <div class="screen-backdrop" aria-hidden="true"></div>
  <div class="poem-on-screen" aria-hidden="true"></div>
  <div class="screen-mask" aria-hidden="true"></div>
  <div class="selected-title" aria-hidden="true"></div>
  <div class="qr-view">
    <a class="qr-item is-active" href="https://axstiz.github.io/Q_polar/" target="_blank" rel="noopener">
      <img class="qr-img" src="/Q_polar/QRs/qr-code_Q-polar.svg" alt="Q-polar" />
      <span class="qr-caption">Q-polar</span>
    </a>
    <a class="qr-item" href="https://t.me/litsummericore" target="_blank" rel="noopener">
      <img class="qr-img" src="/Q_polar/QRs/qr-code_TG.svg" alt="Telegram" />
      <span class="qr-caption">TG-channel</span>
    </a>
  </div>
  <div class="qr-message" aria-hidden="true">
    Для открытия QR кодов,
    <br />выйдите из расширенного вида стихотворения
  </div>
  <div class="screen-reveal" aria-hidden="true">
    <img class="reveal-img reveal-img--back" src="/Q_polar/приставка/обрезанный экран.png" alt="" />
    <img class="reveal-img reveal-img--front" src="/Q_polar/приставка/обрезанный экран.png" alt="" />
  </div>
  <div class="age-label" aria-hidden="true">18+</div>
  <button class="btn btn-arrow btn-dpad-up" data-action="up" aria-label="Вверх"><img src="/Q_polar/приставка/вверх.png" alt="" /></button>
  <button class="btn btn-arrow btn-dpad-left" data-action="left" aria-label="Влево"><img src="/Q_polar/приставка/влево.png" alt="" /></button>
  <button class="btn btn-arrow btn-dpad-right" data-action="right" aria-label="Вправо"><img src="/Q_polar/приставка/вправо.png" alt="" /></button>
  <button class="btn btn-arrow btn-dpad-down" data-action="down" aria-label="Вниз"><img src="/Q_polar/приставка/вниз.png" alt="" /></button>
  <button class="btn btn-big-1" data-action="open" aria-label="Большая 1"><img src="/Q_polar/приставка/большая 1.png" alt="" /></button>
  <button class="btn btn-big-2" data-action="zoom" aria-label="Большая 2"><img src="/Q_polar/приставка/большая 2.png" alt="" /></button>
      <button class="btn btn-small-1" data-action="small1" aria-label="Пауза"><img src="/Q_polar/приставка/маленькая 1.png" alt="" /></button>
      <button class="btn btn-small-2" data-action="small2" aria-label="Воспроизвести"><img src="/Q_polar/приставка/маленькая 2.png" alt="" /></button>
  <button class="btn btn-horizontal" data-action="enter2" aria-label="Enter"><img src="/Q_polar/приставка/горизонтальная.png" alt="" /></button>
  <button class="btn btn-top-solo" data-action="top" aria-label="Верхняя"><img src="/Q_polar/приставка/верхняя соло.png" alt="" /></button>
  <div class="lower-block">
    <img src="/Q_polar/приставка/нижний блок.png" alt="" aria-hidden="true" />
    <div class="spectrum-box" aria-hidden="true"><canvas class="spectrum-canvas"></canvas></div>
    <svg class="volume-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9v6h4l5 4V5L7 9H3z" fill="#ffffff" /><path d="M16 8.5a4 4 0 0 1 0 7" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" fill="none" /><path d="M18.5 6a7 7 0 0 1 0 12" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" fill="none" /></svg>
    <div class="progress-times" aria-hidden="true">
      <span class="progress-time-current">0:00</span>
      <span class="progress-time-total">0:00</span>
    </div>
    <div class="progress-bar" aria-hidden="true"><div class="progress-fill"></div></div>
    <input type="range" class="volume-slider" min="0" max="1" step="0.02" value="1" aria-label="Громкость" />
  </div>
</section>
</div>
<style>
  .console-viewport {
    width: 100%;
    display: flex;
    justify-content: center;
    overflow: hidden;
  }
  #gc {
    outline: none !important;
    flex: none;
    --screen-dx: 0.29cqw;
    --screen-dy: 0.39cqw;
    --reveal-shift-y: 1.2%;
    --screen-top: calc(-1.34% - var(--screen-dy));
    --screen-left: calc(-17.23% - var(--screen-dx));
    --screen-w: 134.27%;
    --screen-h: 54.47%;
    --reveal-w: calc(1524 / 1036 * 100% * 1.1 * 0.98 * 1.01 * 0.995 * 1.002);
    --reveal-top: calc(var(--screen-top) + 2%);
    position: relative;
    margin: 0 auto;
    width: min(100%, calc((100svh - 16px) * 1036 / 2124));
    aspect-ratio: 1036 / 2124;
    container-type: inline-size;
    -webkit-tap-highlight-color: transparent;
    font-family: 'Excalifont', sans-serif;
    text-align: center;
  }
  .console-base {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    z-index: 0;
    pointer-events: none;
    user-select: none;
  }
  .screen {
    position: absolute;
    top: var(--screen-top);
    left: var(--screen-left);
    width: var(--screen-w);
    height: var(--screen-h);
    overflow: hidden;
    clip-path: inset(19.22% 24.34% 19.25% 24.47%);
    z-index: 3;
    pointer-events: none;
    transition: opacity 0.9s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .screen-backdrop {
    position: absolute;
    top: calc(9.13% - 4px);
    top: calc(9.13% - var(--screen-dy));
    left: calc(50% - 4px);
    left: calc(50% - var(--screen-dx));
    width: 68.73%;
    height: 33.52%;
    transform: translateX(-50%);
    background: #fffce8;
    border-radius: 34px;
    border-radius: 3.4cqw;
    z-index: 2;
    pointer-events: none;
    transition: height 0.9s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  #gc.is-open .screen-backdrop {
    height: 60.02%;
  }
  .screen-mask {
    position: absolute;
    top: calc(9.13% - 4px);
    top: calc(9.13% - var(--screen-dy));
    left: calc(50% - 4px);
    left: calc(50% - var(--screen-dx));
    width: 68.73%;
    height: 33.52%;
    transform: translateX(-50%);
    border-radius: 34px;
    border-radius: 3.4cqw;
    z-index: 4;
    pointer-events: none;
    overflow: hidden;
    background: repeating-linear-gradient(to bottom,
      rgba(30, 30, 30, 0.04) 0,
      rgba(30, 30, 30, 0.04) 0.4px,
      transparent 0.4px,
      transparent 3.6px);
    background: repeating-linear-gradient(to bottom,
      rgba(30, 30, 30, 0.04) 0,
      rgba(30, 30, 30, 0.04) 0.039cqw,
      transparent 0.039cqw,
      transparent 0.36cqw);
    transition: height 0.9s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  #gc.is-open .screen-mask {
    height: 60.02%;
  }
  #gc.is-qr .screen {
    opacity: 0;
    pointer-events: none;
  }
  #gc.is-qr .selected-title {
    opacity: 0;
  }
  .qr-view {
    position: absolute;
    top: calc(9.13% - var(--screen-dy));
    left: calc(50% - var(--screen-dx));
    width: 68.73%;
    height: 33.52%;
    transform: translateX(-50%);
    box-sizing: border-box;
    padding: 4%;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 5;
    pointer-events: none;
  }
  #gc.is-qr:not(.is-open) .qr-view {
    display: flex;
  }
  .qr-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
    image-rendering: pixelated;
    pointer-events: none;
  }
  .qr-item {
    position: relative;
    display: none;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    pointer-events: all;
    cursor: pointer;
  }
  .qr-item.is-active {
    display: flex;
    animation: qrFadeIn 0.45s ease;
  }
  @keyframes qrFadeIn {
    from { opacity: 0; transform: scale(0.94); }
    to   { opacity: 1; transform: scale(1); }
  }
  .qr-item:hover .qr-img {
    filter: brightness(0.92);
  }
  .qr-caption {
    position: absolute;
    right: 0.75cqw;
    bottom: -1.2cqw;
    font-family: 'Press Start 2P', monospace;
    font-size: 1.6cqw;
    color: #2d2d2d;
    text-shadow: 0 1px 3px rgba(255, 255, 255, 0.9), 0 0 6px rgba(255, 255, 255, 0.7);
    letter-spacing: 0.05em;
    pointer-events: none;
  }
  .qr-message {
    position: absolute;
    top: calc(9.13% - var(--screen-dy));
    left: calc(50% - var(--screen-dx));
    width: 68.73%;
    height: 60.02%;
    transform: translateX(-50%);
    box-sizing: border-box;
    padding: 8%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    z-index: 8;
    font-family: 'Press Start 2P', monospace;
    font-size: 1.6cqw;
    line-height: 1.8;
    color: #ffffff;
    text-shadow:
      0.15cqw 0.15cqw 0 #e03131,
      0.3cqw 0.3cqw 0 rgba(103, 65, 217, 0.9),
      0 0 1cqw rgba(0, 0, 0, 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  #gc.is-qr.is-open .qr-message {
    opacity: 1;
  }
  .selected-title {
    position: absolute;
    left: calc(50% + 2.5%);
    top: calc(50% + 0.4%);
    width: 100%;
    transform: translate(-50%, -50%);
    z-index: 6;
    pointer-events: none;
    font-family: 'Press Start 2P', monospace;
    color: #ffffff;
    text-shadow:
      0 0 4px rgba(0, 0, 0, 0.7),
      0 0 10px rgba(0, 0, 0, 0.4),
      0 2px 6px rgba(0, 0, 0, 0.5);
    font-size: 2.1875cqw;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-align: center;
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .age-label {
    position: absolute;
    left: calc(50% + 0.45cqw);
    top: 2.5cqw;
    transform: translateX(-50%) rotate(-6deg);
    z-index: 2;
    pointer-events: none;
    user-select: none;
    font-family: 'Permanent Marker', cursive;
    font-size: 5.4cqw;
    line-height: 1;
    color: #2d2d2d;
  }
  .lower-block {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 40.8cqw;
    aspect-ratio: 895 / 1200;
    transform: translate(-12cqw, -120cqw);
    opacity: 0;
    z-index: 0;
    pointer-events: none;
    will-change: transform, opacity;
    transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.3s ease 0.6s;
  }
  .lower-block img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    opacity: 0.8;
  }
.volume-icon {
    position: absolute;
    right: 5cqw;
    bottom: 7.3cqw;
    width: 3.2cqw;
    height: 3.2cqw;
    pointer-events: none;
    opacity: 0.9;
    filter: drop-shadow(0 0 0.4cqw rgba(255, 255, 255, 0.6));
  }
.spectrum-box {
    position: absolute;
    left: 50%;
    bottom: 25cqw;
    width: 26cqw;
    height: 13cqw;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.9);
    border-radius: 1.6cqw;
    overflow: hidden;
    pointer-events: none;
    opacity: 0.95;
  }
  .spectrum-box .spectrum-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
.progress-times {
    position: absolute;
    left: 14%;
    right: 14%;
    bottom: 18.6cqw;
    display: flex;
    justify-content: space-between;
    font-family: 'Press Start 2P', monospace;
    font-size: 1.4cqw;
    line-height: 1;
    color: rgba(255, 255, 255, 0.95);
    text-shadow: 0 0 0.4cqw rgba(0, 0, 0, 0.85);
    pointer-events: none;
  }
  .progress-bar {
    position: absolute;
    left: 14%;
    right: 14%;
    bottom: 16cqw;
    height: 1.6cqw;
    border-radius: 1cqw;
    background: rgba(0, 0, 0, 0.7);
    box-shadow: 0 0 0.9cqw rgba(103, 65, 217, 0.85), 0 0 0.35cqw rgba(103, 65, 217, 0.7);
    overflow: hidden;
    cursor: pointer;
    user-select: none;
    pointer-events: none;
  }
  #gc.is-open .progress-bar {
    pointer-events: auto;
  }
  .progress-fill {
    height: 100%;
    width: 0%;
    border-radius: 1cqw;
    background: rgba(255, 255, 255, 0.9);
    transition: width 0.25s linear;
  }
  .volume-slider {
    position: absolute;
    left: 14%;
    right: 24%;
    bottom: 8cqw;
    width: 62%;
    -webkit-appearance: none;
    appearance: none;
    height: 1.6cqw;
    border-radius: 1cqw;
    background: rgba(0, 0, 0, 0.7);
    box-shadow: 0 0 0.9cqw rgba(103, 65, 217, 0.85), 0 0 0.35cqw rgba(103, 65, 217, 0.7);
    outline: none;
    cursor: pointer;
    pointer-events: none;
    z-index: 2;
  }
  #gc.is-open .volume-slider {
    pointer-events: auto;
  }
  .volume-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 3.4cqw;
    height: 3.4cqw;
    border-radius: 50%;
    background: #6741d9;
    opacity: 0.7;
    border: 0.3cqw solid #2d2d2d;
    box-shadow: 0 0 1.1cqw rgba(255, 255, 255, 0.95), 0 0 0.4cqw rgba(255, 255, 255, 0.7);
    cursor: pointer;
  }
  .volume-slider::-moz-range-thumb {
    width: 3.4cqw;
    height: 3.4cqw;
    border-radius: 50%;
    background: #6741d9;
    opacity: 0.7;
    border: 0.3cqw solid #2d2d2d;
    box-shadow: 0 0 1.1cqw rgba(255, 255, 255, 0.95), 0 0 0.4cqw rgba(255, 255, 255, 0.7);
    cursor: pointer;
  }
  #gc.is-open .lower-block {
    transform: translate(0, -16cqw);
    opacity: 1;
    transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1) 0.9s, opacity 0.3s ease 0.9s;
  }
  #gc .selected-title.has-title {
    opacity: 1;
    transition: opacity 0.3s ease 0.7s, transform 0.3s ease;
  }
  #gc.is-open .selected-title {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  #gc.is-open .screen {
    opacity: 0;
    pointer-events: none;
  }
  .poem-on-screen {
    position: absolute;
    top: calc(9.13% - 4px);
    top: calc(9.13% - var(--screen-dy));
    left: calc(50% - 4px);
    left: calc(50% - var(--screen-dx));
    width: 68.73%;
    height: 60.02%;
    transform: translateX(-50%);
    box-sizing: border-box;
    padding: 7% 0 7% 2%;
    border: 3px solid transparent;
    border: 0.29cqw solid transparent;
    border-radius: 34px;
    border-radius: 3.4cqw;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: safe center;
    text-align: left;
    overflow: auto;
    color: #2a2420;
    font-family: var(--font-handwritten);
    opacity: 0;
    pointer-events: none;
    scrollbar-width: thin;
    scrollbar-color: var(--branch-color, #6741d9) transparent;
    transition: opacity 0.4s ease;
  }
  .poem-on-screen::-webkit-scrollbar {
    width: 1px;
    width: 0.1cqw;
  }
  .poem-on-screen::-webkit-scrollbar-track {
    background: transparent;
  }
  .poem-on-screen::-webkit-scrollbar-thumb {
    background: var(--branch-color, #6741d9);
    border-radius: 1px;
    border-radius: 0.1cqw;
  }
  #gc.is-open .poem-on-screen {
    opacity: 1;
    pointer-events: auto;
    transition: opacity 0.7s ease 0.9s;
  }
  .poem-on-screen :global(.poem-title) {
    color: var(--accent-blue);
    font-size: 55px;
    font-size: 5.31cqw;
    margin: 0 0 0.6em;
    line-height: 1.2;
    text-align: center;
  }
  .poem-on-screen :global(.poem-text) {
    font-size: 44px;
    font-size: 4.25cqw;
    line-height: 1.5;
    white-space: pre-line;
    text-align: left;
  }
  .poem-on-screen :global(.poem-line) {
    margin: 0;
  }
  .poem-on-screen :global(.poem-line.empty) {
    height: 1em;
  }
  #gc :global(.flow-svg) {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    display: block;
    z-index: 3;
    transform: scale(0.6156);
    transform-origin: center;
  }
  #gc :global(.flow-svg.is-animating) {
    transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .screen-reveal {
    position: absolute;
    left: 50%;
    top: calc(50% - 16.13% - var(--reveal-shift-y));
    transform: translate(-50%, -50%);
    width: var(--reveal-w);
    aspect-ratio: 1524 / 590;
    z-index: 1;
    pointer-events: none;
  }
  .screen-reveal .reveal-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    opacity: 1;
    transform: translateY(0);
    transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.3s ease;
    will-change: transform, opacity;
    filter: drop-shadow(0 -2px 6px rgba(0, 0, 0, 0.45));
    filter: drop-shadow(0 -0.19cqw 0.58cqw rgba(0, 0, 0, 0.45));
  }
  .screen-reveal .reveal-img--back { z-index: 1; transition: transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1) 0.12s, opacity 0.3s ease 0.12s; }
  .screen-reveal .reveal-img--front { z-index: 2; transition: transform 0.9s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.3s ease; }
  #gc.is-open .screen-reveal .reveal-img--back { opacity: 1; transform: translateY(55%); }
  #gc.is-open .screen-reveal .reveal-img--front { opacity: 1; transform: translateY(88%); }
  .spkr {
    position: absolute;
    left: 50%;
    bottom: var(--spkr-bottom);
    transform: translateX(-50%);
    display: flex;
    gap: 4px;
    gap: 0.39cqw;
    justify-content: center;
    z-index: 0;
  }
  .spkr span {
    width: 6px;
    width: 0.58cqw;
    height: 18px;
    height: 1.74cqw;
    border-radius: 2px;
    border-radius: 0.19cqw;
    background: #5b5b6b;
  }
  .spkr {
    position: absolute;
    left: 50%;
    bottom: var(--spkr-bottom);
    transform: translateX(-50%);
    display: flex;
    gap: 4px;
    gap: 0.39cqw;
    justify-content: center;
    z-index: 0;
  }
  .spkr span {
    width: 6px;
    width: 0.58cqw;
    height: 18px;
    height: 1.74cqw;
    border-radius: 2px;
    border-radius: 0.19cqw;
    background: #5b5b6b;
  }
  .btn {
    position: absolute;
    z-index: 0;
    border: none;
    background: none;
    padding: 0;
    cursor: pointer;
    pointer-events: all;
    user-select: none;
    -webkit-touch-callout: none;
    touch-action: manipulation;
    outline: none;
    margin: 0;
    transform-origin: center;
    transition: transform 0.09s ease-out;
  }
  .btn img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    pointer-events: none;
    transition: filter 0.12s ease-out, transform 0.09s ease-out;
  }
  .btn:focus-visible {
    outline: 2px solid #6741d9;
    outline-offset: 2px;
    outline: 0.19cqw solid #6741d9;
    outline-offset: 0.19cqw;
    border-radius: 4px;
    border-radius: 0.39cqw;
  }
  .btn:hover img {
    filter: brightness(1.1);
  }
  @keyframes btnPulse {
    0%   { transform: scale(1); }
    35%  { transform: scale(0.88); }
    100% { transform: scale(1); }
  }
  .btn.pressed {
    animation: btnPulse 0.2s ease-out;
  }
  .btn.pressed img {
    filter: brightness(0.7) drop-shadow(0 0 8px rgba(103, 65, 217, 0.95));
  }
  .btn.held {
    transform: scale(0.9);
  }
  .btn-horizontal.held {
    transform: scale(0.96);
  }
  .btn.held img {
    filter: brightness(0.7) drop-shadow(0 0 8px rgba(103, 65, 217, 0.95));
  }
  .btn-dpad-up { left: 15.38%; top: 55.54%; width: 13.43%; height: 6.49%; }
  .btn-dpad-left { left: 4.83%; top: 60.99%; width: 13.43%; height: 6.49%; }
  .btn-dpad-right { left: 26.09%; top: 60.99%; width: 13.43%; height: 6.49%; }
  .btn-dpad-down { left: 15.46%; top: 66.23%; width: 13.43%; height: 6.49%; }
  .btn-big-1 { left: 57.58%; top: 61.93%; width: 18.54%; height: 9.01%; }
  .btn-big-2 { left: 76.81%; top: 58.37%; width: 18.30%; height: 8.90%; }
  .btn-small-1 { left: 24.81%; top: 73.77%; width: 17.58%; height: 8.59%; }
  .btn-small-2 { left: 42.55%; top: 73.77%; width: 17.58%; height: 8.59%; }
  .btn-horizontal { left: -6.12%; top: 83.25%; width: 53.87%; height: 8.17%; }
  .btn-top-solo { left: 12.98%; top: 47.89%; width: 10.71%; height: 5.13%; }
  #gc.is-open .btn-big-1,
  #gc.is-open .btn-big-2,
  #gc.is-open .btn-top-solo {
    opacity: 0.45;
    filter: grayscale(0.85);
    transition: opacity 0.25s ease, filter 0.25s ease;
  }
  .btn-arrow.disabled {
    opacity: 0.45;
    filter: grayscale(0.85);
    transition: opacity 0.25s ease, filter 0.25s ease;
  }
</style>

<script>
  import { NavigationMachine } from '../lib/navMachine.js';
  import { getPoem } from '../data/poems.js';

  const LABELS: Record<string, string> = {
    'Intro': 'intro',
    'Coal': 'coal',
    'Settings': 'settings',
    'Клятва': 'klyatva-exo',
    'экзоскелета': 'klyatva-exo',
    'Blaze': 'blaze',
    'Лаstick': 'lastick',
    'tRace': 'trace',
    'Blue screen': 'blue_screen',
    'Face id': 'face_id',
    'Collapse': 'collapse',
  };

  const TITLE_OVERRIDES: Record<string, string> = {
    'klyatva-exo': 'Клятва EXO',
  };

  const SIMPLE: Record<string, string[]> = {
    intro: ['.intro-dots', '.intro-dots-mirror'],
    coal: ['.coal-elements'],
    settings: ['.settings-effects'],
    blaze: ['.blaze-flames'],
    blue_screen: ['.blue-screen-effects'],
  };

  document.addEventListener('DOMContentLoaded', () => {
    const gc = document.getElementById('gc');
    if (!gc) return;

    const svg = document.querySelector('.flow-svg');
    if (!svg) return;
    const screenEl = gc.querySelector('.screen-backdrop');
    const titleEl = gc.querySelector('.selected-title');

    const globalBBox = (el: Element) => {
      const bb = (el as SVGGraphicsElement).getBBox();
      const owner = (el as SVGGraphicsElement).ownerSVGElement;
      const ctm = (el as SVGGraphicsElement).getCTM();
      if (!owner || !ctm) return bb;
      const p1 = owner.createSVGPoint();
      p1.x = bb.x;
      p1.y = bb.y;
      const p2 = owner.createSVGPoint();
      p2.x = bb.x + bb.width;
      p2.y = bb.y + bb.height;
      const q1 = p1.matrixTransform(ctm);
      const q2 = p2.matrixTransform(ctm);
      return { x: Math.min(q1.x, q2.x), y: Math.min(q1.y, q2.y), width: Math.abs(q2.x - q1.x), height: Math.abs(q2.y - q1.y) };
    };
    const nodes = new Map<string, { border: Element; text: Element }>();
    const isBorder = (e: Element | null): e is Element =>
      !!e && e.tagName === 'g' && e.getAttribute('stroke-linecap') === 'round' && e.hasAttribute('transform');
    svg.querySelectorAll('text').forEach((textEl) => {
      const text = (textEl.textContent || '').trim();
      const id = LABELS[text];
      if (!id || nodes.has(id)) return;
      const textGroup = textEl.parentElement;
      if (!textGroup || textGroup.tagName !== 'g') return;
      const candidates = [textGroup.previousElementSibling, textGroup.nextElementSibling].filter(isBorder);
      let best: Element | null = null;
      if (candidates.length === 1) {
        best = candidates[0];
      } else if (candidates.length > 1) {
        try {
          const tc = globalBBox(textEl);
          const cx = tc.x + tc.width / 2;
          const cy = tc.y + tc.height / 2;
          for (const b of candidates) {
            const bb = globalBBox(b);
            if (cx >= bb.x && cx <= bb.x + bb.width && cy >= bb.y && cy <= bb.y + bb.height) {
              best = b;
              break;
            }
          }
        } catch { /* ignore unrendered group */ }
        if (!best) best = candidates[0];
      }
      if (!best) {
        try {
          const tc = globalBBox(textEl);
          const cx = tc.x + tc.width / 2;
          const cy = tc.y + tc.height / 2;
          let bestArea = Infinity;
          for (const b of svg.querySelectorAll('g[stroke-linecap="round"][transform]')) {
            const bb = globalBBox(b);
            if (cx >= bb.x && cx <= bb.x + bb.width && cy >= bb.y && cy <= bb.y + bb.height) {
              const area = bb.width * bb.height;
              if (area < bestArea) { bestArea = area; best = b; }
            }
          }
        } catch { /* ignore unrendered group */ }
      }
      if (best) {
        best.classList.add('block-border');
        textGroup.classList.add('block-text');
        nodes.set(id, { border: best, text: textGroup });
      }
    });

    const q = (sel: string): Element | null => svg.querySelector(sel);
    const add = (sel: string) => q(sel)?.classList.add('animate');
    const del = (sel: string) => q(sel)?.classList.remove('animate');

    let dropTimer: number | undefined;
    const traceLine = q('.trace-border-line');
    const bloodWrapper = q('.trace-blood-wrapper');
    const bloodDrop = q('.trace-blood-drop');
    const startTrace = () => {
      if (!traceLine) return;
      traceLine.classList.add('animate');
      if (bloodWrapper && bloodDrop) {
        const parent = traceLine.parentElement;
        const tr = parent ? (parent.getAttribute('transform') || '') : '';
        const m = tr.match(/translate\(([\d.]+)[,\s]+([\d.]+)\)/);
        const bx = m ? parseFloat(m[1]) : 1255.79;
        const by = m ? parseFloat(m[2]) : 1243.49;
        bloodWrapper.setAttribute('transform', `translate(${bx + Math.random() * 235.2}, ${by + 235.2 * 0.65 + 18})`);
      }
      dropTimer = window.setTimeout(() => bloodDrop?.classList.add('animate'), 1500);
    };
    const stopTrace = () => {
      traceLine?.classList.remove('animate');
      bloodDrop?.classList.remove('animate');
      if (dropTimer) { clearTimeout(dropTimer); dropTimer = undefined; }
    };

    let lockTimer: number | undefined;
    const faceIdGroup = q('.face-id-effects');
    const startFace = () => {
      faceIdGroup?.classList.add('animate');
      lockTimer = window.setTimeout(() => faceIdGroup?.classList.add('unlocked'), 1500);
    };
    const stopFace = () => {
      faceIdGroup?.classList.remove('animate');
      faceIdGroup?.classList.remove('unlocked');
      if (lockTimer) { clearTimeout(lockTimer); lockTimer = undefined; }
    };

    const NS = 'http://www.w3.org/2000/svg';
    let startCollapse: (() => void) | undefined;
    let stopCollapse: (() => void) | undefined;
    const collapseNode = nodes.get('collapse');
    if (collapseNode) {
      const border = collapseNode.border;
      const clones: Element[] = [];
      const cloneCount = 7;
      const opacities = [0.55, 0.45, 0.36, 0.28, 0.21, 0.15, 0.10];
      const offsets: { x: number; y: number }[] = [];
      const targets: { x: number; y: number }[] = [];
      let frame = 0;
      let active = false;
      let prev = 0;
      const container = document.createElementNS(NS, 'g');
      container.classList.add('collapse-echoes');
      container.style.pointerEvents = 'none';
      svg.appendChild(container);
      const borderTransform = border.getAttribute('transform') || '';
      for (let i = 0; i < cloneCount; i++) {
        const clone = border.cloneNode(true) as Element;
        clone.removeAttribute('class');
        (clone as SVGElement).style.opacity = '0';
        container.appendChild(clone);
        clones.push(clone);
        offsets.push({ x: 0, y: 0 });
        targets.push({ x: 0, y: 0 });
      }
      const tick = (now: number) => {
        if (!prev) prev = now;
        const dt = now - prev;
        prev = now;
        for (let i = 0; i < cloneCount; i++) {
          if (dt > 0 && Math.random() < 0.08) {
            targets[i].x = (Math.random() - 0.5) * 20;
            targets[i].y = (Math.random() - 0.5) * 20;
          }
          const k = 0.04;
          offsets[i].x += (targets[i].x - offsets[i].x) * k;
          offsets[i].y += (targets[i].y - offsets[i].y) * k;
          const scale = 1 + (i + 1) * 0.04;
          clones[i].setAttribute('transform',
            `${borderTransform} translate(117.6, 78.4) scale(${scale}) translate(${-117.6 + offsets[i].x}, ${-78.4 + offsets[i].y})`);
          (clones[i] as SVGElement).style.opacity = String(opacities[i]);
        }
        if (active) frame = requestAnimationFrame(tick);
      };
      startCollapse = () => {
        active = true;
        prev = 0;
        for (let i = 0; i < cloneCount; i++) { offsets[i] = { x: 0, y: 0 }; targets[i] = { x: 0, y: 0 }; }
        if (!frame) frame = requestAnimationFrame(tick);
      };
      stopCollapse = () => {
        active = false;
        for (const c of clones) (c as SVGElement).style.opacity = '0';
        if (frame) { cancelAnimationFrame(frame); frame = 0; }
      };
    }

    const lastickLabel = q('.lastick-label');
    const meText = lastickLabel?.querySelector('.label-me');
    const eraserGroup = lastickLabel?.querySelector('.label-eraser');
    let eraseProgress = 0;
    let eraseTarget = 0;
    let eraseFrame = 0;
    let erasePrev = 0;
    let eraseDelay: number | undefined;
    const eraseTick = (now: number) => {
      if (!erasePrev) erasePrev = now;
      const dt = now - erasePrev;
      erasePrev = now;
      const dir = eraseTarget > eraseProgress ? 1 : -1;
      eraseProgress = Math.max(0, Math.min(1, eraseProgress + dir * (dt / 1000)));
      if (eraserGroup) {
        eraserGroup.setAttribute('transform', `translate(${-100 + 240 * eraseProgress}, 0)`);
        eraserGroup.setAttribute('opacity', String(Math.min(1, eraseProgress * 3)));
      }
      if (meText) {
        (meText as SVGElement).style.clipPath = `inset(0 0 0 ${eraseProgress * 100}%)`;
        meText.style.opacity = eraseProgress < 0.05 ? '1' : String(1 - eraseProgress);
      }
      if (eraseProgress !== eraseTarget) {
        eraseFrame = requestAnimationFrame(eraseTick);
      } else {
        eraseFrame = 0;
        if (eraseTarget === 0 && meText) {
          meText.style.opacity = '1';
          meText.style.clipPath = 'inset(0 0 0 0)';
        }
      }
    };
    const startLastick = () => {
      if (eraseDelay) { clearTimeout(eraseDelay); eraseDelay = undefined; }
      eraseTarget = 1;
      if (!eraseFrame) { erasePrev = 0; eraseFrame = requestAnimationFrame(eraseTick); }
    };
    const stopLastick = () => {
      eraseTarget = 0;
      if (eraseDelay) clearTimeout(eraseDelay);
      eraseDelay = window.setTimeout(() => {
        if (!eraseFrame) { erasePrev = 0; eraseFrame = requestAnimationFrame(eraseTick); }
      }, 0);
    };

    const noop = () => {};
    const ENTER: Record<string, () => void> = {
      intro: () => SIMPLE.intro.forEach(add),
      coal: () => add('.coal-elements'),
      settings: () => add('.settings-effects'),
      blaze: () => add('.blaze-flames'),
      blue_screen: () => add('.blue-screen-effects'),
      trace: startTrace,
      face_id: startFace,
      collapse: startCollapse ?? noop,
      lastick: startLastick,
    };
    const LEAVE: Record<string, () => void> = {
      intro: () => SIMPLE.intro.forEach(del),
      coal: () => del('.coal-elements'),
      settings: () => del('.settings-effects'),
      blaze: () => del('.blaze-flames'),
      blue_screen: () => del('.blue-screen-effects'),
      trace: stopTrace,
      face_id: stopFace,
      collapse: stopCollapse ?? noop,
      lastick: stopLastick,
    };

    const machine = new NavigationMachine();
    let current: string | null = null;

    const ZOOM_FACTOR = 2.5;
    const BASE_SCALE = 0.6156;
    const zoomState = { scale: BASE_SCALE, tx: 0, ty: 0 };
    let zoomOn = false;

    const applyZoomTransform = () => {
      svg.style.transform = `translate(${zoomState.tx}px, ${zoomState.ty}px) scale(${zoomState.scale})`;
    };
    const setAnimated = (on: boolean) => {
      svg.classList.toggle('is-animating', on);
    };
    let zoomAnimTimer: number | undefined;
    const scheduleAnimOff = () => {
      if (zoomAnimTimer) window.clearTimeout(zoomAnimTimer);
      zoomAnimTimer = window.setTimeout(() => setAnimated(false), 650);
    };
    const resetZoomStyle = () => {
      svg.style.transform = '';
    };
    const centerOn = (nodeId: string) => {
      const info = nodes.get(nodeId);
      if (!info) return;
      const sRect = screenEl.getBoundingClientRect();
      const r = info.border.getBoundingClientRect();
      const scx = sRect.left + sRect.width / 2;
      const scy = sRect.top + sRect.height / 2;
      zoomState.tx += scx - (r.left + r.width / 2);
      zoomState.ty += scy - (r.top + r.height / 2);
    };
    const centerOnAnalytic = (nodeId: string) => {
      const info = nodes.get(nodeId);
      if (!info) return;
      const sRect = screenEl.getBoundingClientRect();
      const eRect = svg.getBoundingClientRect();
      const r = info.border.getBoundingClientRect();
      const Sx = sRect.left + sRect.width / 2;
      const Sy = sRect.top + sRect.height / 2;
      const Cx = eRect.left + eRect.width / 2;
      const Cy = eRect.top + eRect.height / 2;
      const rCx = r.left + r.width / 2;
      const rCy = r.top + r.height / 2;
      zoomState.tx = Sx - ZOOM_FACTOR * rCx + (ZOOM_FACTOR - 1) * Cx;
      zoomState.ty = Sy - ZOOM_FACTOR * rCy + (ZOOM_FACTOR - 1) * Cy;
    };
    const enterZoom = () => {
      zoomState.scale = BASE_SCALE * ZOOM_FACTOR;
      setAnimated(false);
      centerOnAnalytic(current ?? 'intro');
      const final = { ...zoomState };
      setAnimated(true);
      resetZoomStyle();
      svg.getBoundingClientRect();
      zoomState.scale = final.scale;
      zoomState.tx = final.tx;
      zoomState.ty = final.ty;
      applyZoomTransform();
      scheduleAnimOff();
    };
    const leaveZoom = () => {
      zoomState.scale = BASE_SCALE;
      zoomState.tx = 0;
      zoomState.ty = 0;
      setAnimated(true);
      resetZoomStyle();
      scheduleAnimOff();
    };
    const toggleZoom = () => {
      if (gc.classList.contains('is-open')) return;
      if (zoomOn) {
        zoomOn = false;
        leaveZoom();
      } else {
        zoomOn = true;
        enterZoom();
      }
    };

    const apply = (node: string) => {
      if (current && LEAVE[current]) LEAVE[current]();
      current = node;
      svg.querySelectorAll('.block-border.selected').forEach((b) => b.classList.remove('selected'));
      const info = nodes.get(node);
      if (info) info.border.classList.add('selected');
      if (ENTER[node]) ENTER[node]();
      const p = getPoem(node);
      if (titleEl) {
        const display = (p && TITLE_OVERRIDES[p.id]) || (p ? p.title : '');
        titleEl.textContent = display;
        titleEl.classList.toggle('has-title', !!display);
      }
      if (zoomOn) {
        setAnimated(false);
        centerOn(node);
        setAnimated(true);
        applyZoomTransform();
        scheduleAnimOff();
      }
      updateArrowGlow();
    };

    const updateArrowGlow = () => {
      const qrActive = gc.classList.contains('is-qr') && !gc.classList.contains('is-open');
      const blockAll = gc.classList.contains('is-open');
      gc.querySelectorAll('.btn-arrow').forEach((b) => {
        const dir = b.dataset.action;
        const ok = blockAll ? false : (qrActive ? true : machine.canMove(dir));
        b.classList.toggle('disabled', !ok);
      });
    };

    machine.subscribe(apply);

    const press = (e: KeyboardEvent) => {
      if (gc.classList.contains('is-qr')) {
        if (e.key === 'Escape') {
          e.preventDefault();
          if (gc.classList.contains('is-open')) closeReveal();
          else exitQr();
          return;
        }
        if (['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(e.key)) { e.preventDefault(); if (!gc.classList.contains('is-open')) stepQr(1); return; }
        return;
      }
      if (gc.classList.contains('is-open')) {
        if (e.key === 'Escape') { e.preventDefault(); closeReveal(); }
        return;
      }
      switch (e.key) {
        case 'ArrowRight': e.preventDefault(); machine.right(); break;
        case 'ArrowLeft': e.preventDefault(); machine.left(); break;
        case 'ArrowUp': e.preventDefault(); machine.up(); break;
        case 'ArrowDown': e.preventDefault(); machine.down(); break;
        case 'Enter': case ' ': e.preventDefault(); revealScreen(); break;
        case 'Backspace': e.preventDefault(); machine.left(); break;
        case 'Escape': e.preventDefault(); closeReveal(); break;
      }
    };
    window.addEventListener('keydown', press);

    const alphaCache = new Map();
    function loadAlpha(src) {
      if (alphaCache.has(src)) return;
      alphaCache.set(src, null);
      const im = new Image();
      im.onload = () => {
        const c = document.createElement('canvas');
        c.width = im.naturalWidth; c.height = im.naturalHeight;
        const ctx = c.getContext('2d');
        ctx.drawImage(im, 0, 0);
        let rec = null;
        try {
          const data = ctx.getImageData(0, 0, c.width, c.height).data;
          rec = { data, w: c.width, h: c.height };
        } catch (err) { rec = null; }
        alphaCache.set(src, rec);
      };
      im.src = src;
    }
    function isOpaque(img, clientX, clientY) {
      const rec = alphaCache.get(img.src);
      if (!rec) return true;
      const r = img.getBoundingClientRect();
      const scale = Math.min(r.width / rec.w, r.height / rec.h);
      const offX = (r.width - rec.w * scale) / 2;
      const offY = (r.height - rec.h * scale) / 2;
      const x = (clientX - r.left - offX) / scale;
      const y = (clientY - r.top - offY) / scale;
      if (x < 0 || y < 0 || x >= rec.w || y >= rec.h) return false;
      const a = rec.data[((y | 0) * rec.w + (x | 0)) * 4 + 3];
      return a > 30;
    }

    const rawBase = import.meta.env.BASE_URL ?? '/';
    const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
    const TRACK_SLUGS: Record<string, string> = {
      blue_screen: 'blue-screen',
      face_id: 'face-id',
      'klyatva-exo': 'klyatva',
    };
    const audio = new Audio();
    audio.preload = 'none';
    audio.addEventListener('error', () => console.warn('[gc] audio error:', audio.src));
    let currentTrack = '';
    let analyser: AnalyserNode | null = null;
    function ensureAnalyser() {
      if (analyser) return;
      try {
        const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
        const src = ctx.createMediaElementSource(audio);
        const node = ctx.createAnalyser();
        node.fftSize = 256;
        node.smoothingTimeConstant = 0.78;
        src.connect(node);
        node.connect(ctx.destination);
        analyser = node;
        if (ctx.state === 'suspended') ctx.resume().catch(() => {});
      } catch {
        analyser = null;
      }
    }
    function playMusic() {
      ensureAnalyser();
      const slug = TRACK_SLUGS[machine.current] ?? machine.current;
      if (currentTrack !== slug) {
        audio.src = `${base}audio/${slug}.mp3`;
        currentTrack = slug;
      }
      audio.play().catch((err) => console.warn('[gc] audio play failed:', err));
    }
    function pauseMusic() {
      audio.pause();
    }
    function act(btn) {
      if (btn.classList.contains('disabled')) return;
      const action = btn.dataset.action;
      if (action === 'top') { toggleQR(); return; }
      if (gc.classList.contains('is-qr') && !gc.classList.contains('is-open')) {
        if (['up', 'down', 'left', 'right'].includes(action)) { stepQr(1); return; }
        if (action === 'enter2') { exitQr(); return; }
        return;
      }
      if (gc.classList.contains('is-open') && ['up', 'down', 'left', 'right', 'open', 'zoom'].includes(action)) return;
      if (action === 'up') machine.up();
      else if (action === 'left') machine.left();
      else if (action === 'right') machine.right();
      else if (action === 'down') machine.down();
      else if (action === 'open') revealScreen();
      else if (action === 'enter2') closeReveal();
      else if (action === 'small1') pauseMusic();
      else if (action === 'small2') playMusic();
      else if (action === 'zoom') toggleZoom();
    }
    function pulse(btn) {
      btn.classList.remove('pressed');
      void btn.offsetWidth;
      btn.classList.add('pressed');
      setTimeout(() => btn.classList.remove('pressed'), 220);
    }
    const BRANCH_COLORS: Record<string, string> = {
      top: '#e03131',
      bottom: '#6741d9',
      shared: '#6741d9',
    };
    const poemEl = gc.querySelector('.poem-on-screen');
    function renderPoem(id) {
      const p = getPoem(id);
      if (!poemEl) return;
      if (!p) { poemEl.replaceChildren(); return; }
      const title = document.createElement('div');
      title.className = 'poem-title';
      title.textContent = p.title;
      const branchColor = BRANCH_COLORS[p.branch] || '#6741d9';
      title.style.color = branchColor;
      poemEl.style.setProperty('--branch-color', branchColor);
      const text = document.createElement('div');
      text.className = 'poem-text';
      for (const line of p.lines) {
        const ln = document.createElement('p');
        ln.className = 'poem-line' + (line === '' ? ' empty' : '');
        ln.textContent = line;
        text.appendChild(ln);
      }
      poemEl.replaceChildren(title, text);
    }
    function revealScreen() {
      renderPoem(machine.current);
      gc.classList.remove('is-open');
      void gc.offsetWidth;
      gc.classList.add('is-open');
      updateArrowGlow();
    }
    function closeReveal() {
      gc.classList.remove('is-open');
      updateArrowGlow();
    }

    const qrItems = Array.from(gc.querySelectorAll('.qr-item'));
    let qrOn = false;
    let qrIndex = 0;
    function renderQr() {
      qrItems.forEach((item, i) => item.classList.toggle('is-active', i === qrIndex));
    }
    function stepQr(dir: number) {
      if (qrItems.length === 0) return;
      qrIndex = (qrIndex + dir + qrItems.length) % qrItems.length;
      renderQr();
    }
    function toggleQR() {
      if (qrOn) { exitQr(); return; }
      qrOn = true;
      qrIndex = 0;
      renderQr();
      gc.classList.add('is-qr');
      updateArrowGlow();
    }
    function exitQr() {
      qrOn = false;
      gc.classList.remove('is-qr');
      updateArrowGlow();
    }

    gc.querySelectorAll('.btn').forEach(btn => {
      const img = btn.querySelector('img');
      if (img) loadAlpha(img.src);
      let held = false;
      btn.addEventListener('pointerdown', (e) => {
        if (btn.classList.contains('disabled')) return;
        if (img && !isOpaque(img, e.clientX, e.clientY)) return;
        held = true;
        btn.classList.add('held');
      });
      const release = () => {
        if (!held) return;
        held = false;
        btn.classList.remove('held');
        act(btn);
      };
      btn.addEventListener('pointerup', release);
      btn.addEventListener('pointerleave', () => { held = false; btn.classList.remove('held'); });
      btn.addEventListener('pointercancel', () => { held = false; btn.classList.remove('held'); });
      btn.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          if (btn.classList.contains('disabled')) return;
          act(btn);
          pulse(btn);
        }
      });
    });

    const volumeSlider = gc.querySelector('.volume-slider');
    if (volumeSlider) {
      volumeSlider.addEventListener('input', () => {
        audio.volume = Number(volumeSlider.value);
      });
    }

    const progressFill = gc.querySelector('.progress-fill');
    const progressBar = gc.querySelector('.progress-bar');
    const timeCurrent = gc.querySelector('.progress-time-current');
    const timeTotal = gc.querySelector('.progress-time-total');
    const fmtTime = (s: number) => {
      if (!Number.isFinite(s) || s < 0) s = 0;
      const m = Math.floor(s / 60);
      const ss = Math.floor(s % 60);
      return `${m}:${ss < 10 ? '0' : ''}${ss}`;
    };
    if (progressFill) {
      audio.addEventListener('timeupdate', () => {
        if (audio.duration) {
          progressFill.style.width = `${(audio.currentTime / audio.duration) * 100}%`;
        }
        if (timeCurrent) timeCurrent.textContent = fmtTime(audio.currentTime);
      });
      audio.addEventListener('loadedmetadata', () => {
        progressFill.style.width = '0%';
        if (timeCurrent) timeCurrent.textContent = '0:00';
        if (timeTotal) timeTotal.textContent = fmtTime(audio.duration);
      });
      audio.addEventListener('ended', () => {
        progressFill.style.width = '0%';
        if (timeCurrent) timeCurrent.textContent = '0:00';
      });
    }
    if (progressBar && progressFill) {
      const seekFromClientX = (x: number) => {
        if (!audio.duration) return;
        const r = progressBar.getBoundingClientRect();
        let t = (x - r.left) / r.width;
        t = Math.max(0, Math.min(1, t));
        audio.currentTime = t * audio.duration;
        progressFill.style.width = `${t * 100}%`;
        if (timeCurrent) timeCurrent.textContent = fmtTime(audio.currentTime);
      };
      let scrubbing = false;
      progressBar.addEventListener('pointerdown', (e) => {
        scrubbing = true;
        progressBar.setPointerCapture(e.pointerId);
        seekFromClientX(e.clientX);
      });
      progressBar.addEventListener('pointermove', (e) => {
        if (scrubbing) seekFromClientX(e.clientX);
      });
      const endScrub = () => { scrubbing = false; };
      progressBar.addEventListener('pointerup', endScrub);
      progressBar.addEventListener('pointercancel', endScrub);
    }

    const spectrum = gc.querySelector('.spectrum-canvas') as HTMLCanvasElement | null;
    if (spectrum && spectrum.getContext) {
      const sctx = spectrum.getContext('2d');
      if (sctx) {
        const BARS = 16;
        let freq = new Uint8Array(0);
        const binOf = (i: number) => {
          const n = analyser ? analyser.frequencyBinCount : 64;
          const lo = Math.log(20), hi = Math.log(12000);
          const t = Math.pow((i + 0.5) / BARS, 1.35);
          const f = Math.exp(lo + (hi - lo) * t);
          return Math.min(n - 1, Math.max(0, Math.round(f / (analyser ? analyser.context.sampleRate : 44100) * n)));
        };
        const draw = () => {
          const r = spectrum.getBoundingClientRect();
          const dpr = window.devicePixelRatio || 1;
          const w = Math.max(1, Math.round(r.width * dpr));
          const h = Math.max(1, Math.round(r.height * dpr));
          if (spectrum.width !== w || spectrum.height !== h) {
            spectrum.width = w;
            spectrum.height = h;
          }
          sctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          sctx.clearRect(0, 0, r.width, r.height);
          let barGap = r.width * 0.05;
          let barW = (r.width - barGap * (BARS - 1)) / BARS;
          if (barW < 1.5) {
            barW = 1.5;
            barGap = BARS > 1 ? (r.width - BARS * barW) / (BARS - 1) : 0;
            if (barGap < 0) barGap = 0;
          }
          const live = analyser && !audio.paused && audio.volume > 0;
          if (live) {
            const n = analyser!.frequencyBinCount;
            if (freq.length !== n) freq = new Uint8Array(n);
            analyser!.getByteFrequencyData(freq);
          }
          for (let i = 0; i < BARS; i++) {
            const v = live
              ? freq[binOf(i)] / 255
              : 0.22 + 0.3 * (0.5 + 0.5 * Math.sin(Date.now() / 380 + i * 0.9)) * (0.6 + 0.4 * Math.sin(Date.now() / 160 + i * 2.1));
            const bh = Math.max(0.18 * r.height, Math.min(1, v) * r.height);
            const x = i * (barW + barGap);
            const y = r.height - bh;
            sctx.shadowColor = 'rgba(103, 65, 217, 0.85)';
            sctx.shadowBlur = r.height * 0.35;
            const grad = sctx.createLinearGradient(0, y, 0, r.height);
            grad.addColorStop(0, '#ffffff');
            grad.addColorStop(0.35, '#ffffff');
            grad.addColorStop(1, '#6741d9');
            sctx.fillStyle = grad;
            const rad = Math.min(barW / 2, r.height * 0.18);
            if (sctx.roundRect) {
              sctx.beginPath();
              sctx.roundRect(x, y, barW, bh, rad);
              sctx.fill();
            } else {
              sctx.fillRect(x, y + rad, barW, bh - rad);
              sctx.beginPath();
              sctx.arc(x + rad, y + rad, rad, Math.PI, 0, false);
              sctx.fill();
              sctx.beginPath();
              sctx.arc(x + barW - rad, y + rad, rad, Math.PI, 0, true);
              sctx.fill();
            }
          }
        };
        const loop = () => {
          if (gc.classList.contains('is-open')) draw();
          requestAnimationFrame(loop);
        };
        requestAnimationFrame(loop);
      }
    }

  });
</script>

