---
import FlowDiagram from './FlowDiagram.astro';
---
<section id="gc">
  <img class="console-base" src="/Q_polar/console-base.png" alt="" />
  <div class="screen">
    <FlowDiagram />
  </div>
  <div class="spkr"><span></span><span></span><span></span><span></span></div>
</section>
<style>
  #gc {
    outline: none !important;
  }
  #gc {
    --screen-top: 2%;
    --screen-left: 8%;
    --screen-w: 84%;
    --screen-h: 52%;
    --spkr-bottom: 5%;
    position: relative;
    margin: 0 auto;
    width: min(100%, 760px);
    aspect-ratio: 1656 / 2225;
    font-family: 'Excalifont', sans-serif;
    text-align: center;
  }
  .console-base {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    z-index: 0;
    pointer-events: none;
    user-select: none;
  }
  .screen {
    position: absolute;
    top: var(--screen-top);
    left: var(--screen-left);
    width: var(--screen-w);
    height: var(--screen-h);
    overflow: hidden;
    z-index: 1;
  }
  #gc :global(.flow-svg) {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    display: block;
    z-index: 1;
    transform: scale(0.6156);
    transform-origin: center;
  }
  .spkr {
    position: absolute;
    left: 50%;
    bottom: var(--spkr-bottom);
    transform: translateX(-50%);
    display: flex;
    gap: 4px;
    justify-content: center;
    z-index: 2;
  }
  .spkr span {
    width: 6px;
    height: 18px;
    border-radius: 2px;
    background: #5b5b6b;
  }
</style>

<script>
  import { NavigationMachine } from '../lib/navMachine.js';

  const LABELS: Record<string, string> = {
    'Intro': 'intro',
    'Coal': 'coal',
    'Settings': 'settings',
    'Клятва': 'klyatva-exo',
    'экзоскелета': 'klyatva-exo',
    'Blaze': 'blaze',
    'Лаstick': 'lastick',
    'tRace': 'trace',
    'Blue screen': 'blue_screen',
    'Face id': 'face_id',
    'Collapse': 'collapse',
  };

  const SIMPLE: Record<string, string[]> = {
    intro: ['.intro-dots', '.intro-dots-mirror'],
    coal: ['.coal-elements'],
    settings: ['.settings-effects'],
    blaze: ['.blaze-flames'],
    blue_screen: ['.blue-screen-effects'],
  };

  document.addEventListener('DOMContentLoaded', () => {
    const gc = document.getElementById('gc');
    if (gc) {
      const availW = gc.parentElement ? gc.parentElement.clientWidth : window.innerWidth;
      const availH = window.innerHeight - 80;
      const aspect = 1656 / 2225;
      const w = Math.max(280, Math.min(availW, availH * aspect, 760));
      gc.style.width = w + 'px';
    }

    const svg = document.querySelector('.flow-svg');
    if (!svg) return;

    const nodes = new Map<string, { border: Element; text: Element }>();
    const isBorder = (e: Element | null): e is Element =>
      !!e && e.tagName === 'g' && e.getAttribute('stroke-linecap') === 'round';
    svg.querySelectorAll('text').forEach((textEl) => {
      const text = (textEl.textContent || '').trim();
      const id = LABELS[text];
      if (!id || nodes.has(id)) return;
      const textGroup = textEl.parentElement;
      if (!textGroup || textGroup.tagName !== 'g') return;
      const candidates = [textGroup.previousElementSibling, textGroup.nextElementSibling].filter(isBorder);
      let best: Element | null = null;
      if (candidates.length === 1) {
        best = candidates[0];
      } else if (candidates.length > 1) {
        try {
          const tb = textEl.getBBox();
          const cx = tb.x + tb.width / 2;
          const cy = tb.y + tb.height / 2;
          for (const b of candidates) {
            const bb = b.getBBox();
            if (cx >= bb.x && cx <= bb.x + bb.width && cy >= bb.y && cy <= bb.y + bb.height) {
              best = b;
              break;
            }
          }
        } catch { /* ignore unrendered group */ }
        if (!best) best = candidates[0];
      }
      if (best) {
        best.classList.add('block-border');
        textGroup.classList.add('block-text');
        nodes.set(id, { border: best, text: textGroup });
      }
    });

    const q = (sel: string): Element | null => svg.querySelector(sel);
    const add = (sel: string) => q(sel)?.classList.add('animate');
    const del = (sel: string) => q(sel)?.classList.remove('animate');

    let dropTimer: number | undefined;
    const traceLine = q('.trace-border-line');
    const bloodWrapper = q('.trace-blood-wrapper');
    const bloodDrop = q('.trace-blood-drop');
    const startTrace = () => {
      if (!traceLine) return;
      traceLine.classList.add('animate');
      if (bloodWrapper && bloodDrop) {
        const parent = traceLine.parentElement;
        const tr = parent ? (parent.getAttribute('transform') || '') : '';
        const m = tr.match(/translate\(([\d.]+)[,\s]+([\d.]+)\)/);
        const bx = m ? parseFloat(m[1]) : 1255.79;
        const by = m ? parseFloat(m[2]) : 1243.49;
        bloodWrapper.setAttribute('transform', `translate(${bx + Math.random() * 235.2}, ${by + 235.2 * 0.65 + 18})`);
      }
      dropTimer = window.setTimeout(() => bloodDrop?.classList.add('animate'), 1500);
    };
    const stopTrace = () => {
      traceLine?.classList.remove('animate');
      bloodDrop?.classList.remove('animate');
      if (dropTimer) { clearTimeout(dropTimer); dropTimer = undefined; }
    };

    let lockTimer: number | undefined;
    const faceIdGroup = q('.face-id-effects');
    const startFace = () => {
      faceIdGroup?.classList.add('animate');
      lockTimer = window.setTimeout(() => faceIdGroup?.classList.add('unlocked'), 1500);
    };
    const stopFace = () => {
      faceIdGroup?.classList.remove('animate');
      faceIdGroup?.classList.remove('unlocked');
      if (lockTimer) { clearTimeout(lockTimer); lockTimer = undefined; }
    };

    const NS = 'http://www.w3.org/2000/svg';
    let startCollapse: (() => void) | undefined;
    let stopCollapse: (() => void) | undefined;
    const collapseNode = nodes.get('collapse');
    if (collapseNode) {
      const border = collapseNode.border;
      const clones: Element[] = [];
      const cloneCount = 7;
      const opacities = [0.55, 0.45, 0.36, 0.28, 0.21, 0.15, 0.10];
      const offsets: { x: number; y: number }[] = [];
      const targets: { x: number; y: number }[] = [];
      let frame = 0;
      let active = false;
      let prev = 0;
      const container = document.createElementNS(NS, 'g');
      container.classList.add('collapse-echoes');
      container.style.pointerEvents = 'none';
      svg.appendChild(container);
      const borderTransform = border.getAttribute('transform') || '';
      for (let i = 0; i < cloneCount; i++) {
        const clone = border.cloneNode(true) as Element;
        clone.removeAttribute('class');
        (clone as SVGElement).style.opacity = '0';
        container.appendChild(clone);
        clones.push(clone);
        offsets.push({ x: 0, y: 0 });
        targets.push({ x: 0, y: 0 });
      }
      const tick = (now: number) => {
        if (!prev) prev = now;
        const dt = now - prev;
        prev = now;
        for (let i = 0; i < cloneCount; i++) {
          if (dt > 0 && Math.random() < 0.08) {
            targets[i].x = (Math.random() - 0.5) * 20;
            targets[i].y = (Math.random() - 0.5) * 20;
          }
          const k = 0.04;
          offsets[i].x += (targets[i].x - offsets[i].x) * k;
          offsets[i].y += (targets[i].y - offsets[i].y) * k;
          const scale = 1 + (i + 1) * 0.04;
          clones[i].setAttribute('transform',
            `${borderTransform} translate(117.6, 78.4) scale(${scale}) translate(${-117.6 + offsets[i].x}, ${-78.4 + offsets[i].y})`);
          (clones[i] as SVGElement).style.opacity = String(opacities[i]);
        }
        if (active) frame = requestAnimationFrame(tick);
      };
      startCollapse = () => {
        active = true;
        prev = 0;
        for (let i = 0; i < cloneCount; i++) { offsets[i] = { x: 0, y: 0 }; targets[i] = { x: 0, y: 0 }; }
        if (!frame) frame = requestAnimationFrame(tick);
      };
      stopCollapse = () => {
        active = false;
        for (const c of clones) (c as SVGElement).style.opacity = '0';
        if (frame) { cancelAnimationFrame(frame); frame = 0; }
      };
    }

    const lastickLabel = q('.lastick-label');
    const meText = lastickLabel?.querySelector('.label-me');
    const eraserGroup = lastickLabel?.querySelector('.label-eraser');
    let eraseProgress = 0;
    let eraseTarget = 0;
    let eraseFrame = 0;
    let erasePrev = 0;
    let eraseDelay: number | undefined;
    const eraseTick = (now: number) => {
      if (!erasePrev) erasePrev = now;
      const dt = now - erasePrev;
      erasePrev = now;
      const dir = eraseTarget > eraseProgress ? 1 : -1;
      eraseProgress = Math.max(0, Math.min(1, eraseProgress + dir * (dt / 1000)));
      if (eraserGroup) {
        eraserGroup.setAttribute('transform', `translate(${-100 + 240 * eraseProgress}, 0)`);
        eraserGroup.setAttribute('opacity', String(Math.min(1, eraseProgress * 3)));
      }
      if (meText) {
        (meText as SVGElement).style.clipPath = `inset(0 0 0 ${eraseProgress * 100}%)`;
        meText.style.opacity = eraseProgress < 0.05 ? '1' : String(1 - eraseProgress);
      }
      if (eraseProgress !== eraseTarget) {
        eraseFrame = requestAnimationFrame(eraseTick);
      } else {
        eraseFrame = 0;
        if (eraseTarget === 0 && meText) {
          meText.style.opacity = '1';
          meText.style.clipPath = 'inset(0 0 0 0)';
        }
      }
    };
    const startLastick = () => {
      if (eraseDelay) { clearTimeout(eraseDelay); eraseDelay = undefined; }
      eraseTarget = 1;
      if (!eraseFrame) { erasePrev = 0; eraseFrame = requestAnimationFrame(eraseTick); }
    };
    const stopLastick = () => {
      eraseTarget = 0;
      if (eraseDelay) clearTimeout(eraseDelay);
      eraseDelay = window.setTimeout(() => {
        if (!eraseFrame) { erasePrev = 0; eraseFrame = requestAnimationFrame(eraseTick); }
      }, 0);
    };

    const noop = () => {};
    const ENTER: Record<string, () => void> = {
      intro: () => SIMPLE.intro.forEach(add),
      coal: () => add('.coal-elements'),
      settings: () => add('.settings-effects'),
      blaze: () => add('.blaze-flames'),
      blue_screen: () => add('.blue-screen-effects'),
      trace: startTrace,
      face_id: startFace,
      collapse: startCollapse ?? noop,
      lastick: startLastick,
    };
    const LEAVE: Record<string, () => void> = {
      intro: () => SIMPLE.intro.forEach(del),
      coal: () => del('.coal-elements'),
      settings: () => del('.settings-effects'),
      blaze: () => del('.blaze-flames'),
      blue_screen: () => del('.blue-screen-effects'),
      trace: stopTrace,
      face_id: stopFace,
      collapse: stopCollapse ?? noop,
      lastick: stopLastick,
    };

    const machine = new NavigationMachine();
    let current: string | null = null;

    const apply = (node: string) => {
      if (current && LEAVE[current]) LEAVE[current]();
      current = node;
      svg.querySelectorAll('.block-border.selected').forEach((b) => b.classList.remove('selected'));
      const info = nodes.get(node);
      if (info) info.border.classList.add('selected');
      if (ENTER[node]) ENTER[node]();
    };

    machine.subscribe(apply);

    const press = (e: KeyboardEvent) => {
      switch (e.key) {
        case 'ArrowRight': e.preventDefault(); machine.right(); break;
        case 'ArrowLeft': e.preventDefault(); machine.left(); break;
        case 'ArrowUp': e.preventDefault(); machine.up(); break;
        case 'ArrowDown': e.preventDefault(); machine.down(); break;
        case 'Enter': case ' ': e.preventDefault(); machine.open(); break;
        case 'Backspace': e.preventDefault(); machine.left(); break;
        case 'Escape': e.preventDefault(); machine.reset(); break;
      }
    };
    window.addEventListener('keydown', press);

  });
</script>
