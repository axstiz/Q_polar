---
/**
 * FlowDiagram.astro — Интерактивная схема сборника
 *
 * Оригинальный SVG из Excalidraw инлайн.
 * Блок = пара <g>: border (path stroke #1e1e1e) + text.
 * Hover: подсветка рамки (drop-shadow). Клик → страница стиха.
 */
import { readFileSync } from 'fs';
import { join } from 'path';

const svgPath = join(process.cwd(), 'main_schema.svg');
const svgContent = readFileSync(svgPath, 'utf-8');
const svgBody = svgContent.replace(/<svg[^>]*>/, '').replace(/<\/svg>/, '');
---

<div class="diagram-wrapper">
  <svg
    viewBox="0 0 2433 1520"
    xmlns="http://www.w3.org/2000/svg"
    class="flow-svg"
    set:html={svgBody}
  />
</div>

<style>
  .diagram-wrapper { width: 100%; margin: 0 auto; }
  .flow-svg { width: 100%; height: auto; display: block; }

  /* Hover: только подсветка рамки, без движения */
  :global(.block-border) {
    cursor: pointer;
    transition: filter 0.2s ease;
  }
  :global(.block-border.hovered) {
    filter: drop-shadow(0 0 8px rgba(103, 65, 217, 0.5));
  }
  :global(.block-text) {
    cursor: pointer;
    pointer-events: all;
  }

  /* ===== Точки Intro: анимация волны при hover ===== */
  :global(.intro-dots, .intro-dots-mirror) {
    pointer-events: none;
  }

  /* Базовое состояние: используем --dot-base */
  :global(.intro-dots .intro-dot, .intro-dots-mirror .intro-dot) {
    opacity: var(--dot-base, 0.5);
  }

  @keyframes dotWave {
    0%, 100% { opacity: var(--dot-base, 0.5); }
    50% { opacity: calc(var(--dot-base, 0.5) + 0.25); }
  }

  :global(.intro-dots.animate .intro-dot, .intro-dots-mirror.animate .intro-dot) {
    animation: dotWave 1.2s ease-in-out infinite;
  }
  :global(.intro-dots.animate .intro-dot[data-dot="1"], .intro-dots-mirror.animate .intro-dot[data-dot="1"])  { animation-delay: 0s; }
  :global(.intro-dots.animate .intro-dot[data-dot="2"], .intro-dots-mirror.animate .intro-dot[data-dot="2"])  { animation-delay: 0.08s; }
  :global(.intro-dots.animate .intro-dot[data-dot="3"], .intro-dots-mirror.animate .intro-dot[data-dot="3"])  { animation-delay: 0.16s; }
  :global(.intro-dots.animate .intro-dot[data-dot="4"], .intro-dots-mirror.animate .intro-dot[data-dot="4"])  { animation-delay: 0.24s; }
  :global(.intro-dots.animate .intro-dot[data-dot="5"], .intro-dots-mirror.animate .intro-dot[data-dot="5"])  { animation-delay: 0.32s; }
  :global(.intro-dots.animate .intro-dot[data-dot="6"], .intro-dots-mirror.animate .intro-dot[data-dot="6"])  { animation-delay: 0.08s; }
  :global(.intro-dots.animate .intro-dot[data-dot="7"], .intro-dots-mirror.animate .intro-dot[data-dot="7"])  { animation-delay: 0.16s; }
  :global(.intro-dots.animate .intro-dot[data-dot="8"], .intro-dots-mirror.animate .intro-dot[data-dot="8"])  { animation-delay: 0.24s; }
  :global(.intro-dots.animate .intro-dot[data-dot="9"], .intro-dots-mirror.animate .intro-dot[data-dot="9"])  { animation-delay: 0.32s; }
  :global(.intro-dots.animate .intro-dot[data-dot="10"], .intro-dots-mirror.animate .intro-dot[data-dot="10"]) { animation-delay: 0.40s; }
  :global(.intro-dots.animate .intro-dot[data-dot="11"], .intro-dots-mirror.animate .intro-dot[data-dot="11"]) { animation-delay: 0.16s; }
  :global(.intro-dots.animate .intro-dot[data-dot="12"], .intro-dots-mirror.animate .intro-dot[data-dot="12"]) { animation-delay: 0.24s; }
  :global(.intro-dots.animate .intro-dot[data-dot="13"], .intro-dots-mirror.animate .intro-dot[data-dot="13"]) { animation-delay: 0.32s; }
  :global(.intro-dots.animate .intro-dot[data-dot="14"], .intro-dots-mirror.animate .intro-dot[data-dot="14"]) { animation-delay: 0.40s; }
  :global(.intro-dots.animate .intro-dot[data-dot="15"], .intro-dots-mirror.animate .intro-dot[data-dot="15"]) { animation-delay: 0.48s; }

  /* ===== Ромбы Coal: движение + исчезновение + возврат при hover ===== */
  :global(.coal-elements) {
    pointer-events: none;
  }
  :global(.coal-elements .coal-diamond) {
    opacity: var(--diamond-base);
  }

  @keyframes coalMove {
    0%   { opacity: var(--diamond-base); transform: translate(0, 0) rotate(0deg) scale(1); }
    12%  { opacity: 0; transform: translate(var(--dx), var(--dy)) rotate(var(--dr)) scale(var(--scale)); }
    13%  { opacity: 0; transform: translate(0, 0) rotate(0deg) scale(1); }
    25%  { opacity: var(--diamond-base); transform: translate(0, 0) rotate(0deg) scale(1); }
    37%  { opacity: 0; transform: translate(var(--dx), var(--dy)) rotate(var(--dr)) scale(var(--scale)); }
    38%  { opacity: 0; transform: translate(0, 0) rotate(0deg) scale(1); }
    50%  { opacity: var(--diamond-base); transform: translate(0, 0) rotate(0deg) scale(1); }
    62%  { opacity: 0; transform: translate(var(--dx), var(--dy)) rotate(var(--dr)) scale(var(--scale)); }
    63%  { opacity: 0; transform: translate(0, 0) rotate(0deg) scale(1); }
    75%  { opacity: var(--diamond-base); transform: translate(0, 0) rotate(0deg) scale(1); }
    87%  { opacity: 0; transform: translate(var(--dx), var(--dy)) rotate(var(--dr)) scale(var(--scale)); }
    88%  { opacity: 0; transform: translate(0, 0) rotate(0deg) scale(1); }
    100% { opacity: var(--diamond-base); transform: translate(0, 0) rotate(0deg) scale(1); }
  }

  :global(.coal-elements.animate .coal-diamond) {
    animation: coalMove 1.8s linear infinite;
  }
  :global(.coal-elements.animate .coal-diamond[data-diamond="1"]) { animation-delay: 0s; }
  :global(.coal-elements.animate .coal-diamond[data-diamond="2"]) { animation-delay: -0.1125s; }
  :global(.coal-elements.animate .coal-diamond[data-diamond="3"]) { animation-delay: -0.225s; }
  :global(.coal-elements.animate .coal-diamond[data-diamond="4"]) { animation-delay: -0.3375s; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const svg = document.querySelector('.flow-svg');
    if (!svg) return;

    const blockMap: Record<string, string> = {
      'Intro': 'intro',
      'Coal': 'coal',
      'Settings': 'settings',
      'Blaze': 'blaze',
      'Blue screen': 'blue-screen',
      'Face id': 'face-id',
      'tRace': 'trace',
      'Лаstick': 'lastick',
      'Collapse': 'collapse',
    };

    // Находим все <text> элементы
    const textEls = svg.querySelectorAll('text');

    textEls.forEach((textEl) => {
      const text = textEl.textContent?.trim() || '';
      const blockId = blockMap[text];
      if (!blockId) return;

      const textGroup = textEl.parentElement;
      if (!textGroup || textGroup.tagName !== 'g') return;

      // Ищем группу рамки — поднимаемся вверх по предыдущим sibling,
      // пока не найдём <g> со stroke-linecap="round" (рамка)
      let borderGroup: Element | null = null;
      let sibling: Element | null = textGroup.previousElementSibling;
      while (sibling) {
        if (sibling.tagName === 'g' && sibling.getAttribute('stroke-linecap') === 'round') {
          borderGroup = sibling;
          break;
        }
        sibling = sibling.previousElementSibling;
      }

      if (borderGroup) borderGroup.classList.add('block-border');
      textGroup.classList.add('block-text');

      const highlight = () => {
        if (borderGroup) borderGroup.classList.add('hovered');
      };
      const unhighlight = () => {
        if (borderGroup) borderGroup.classList.remove('hovered');
      };

      if (borderGroup) {
        borderGroup.addEventListener('mouseenter', highlight);
        borderGroup.addEventListener('mouseleave', unhighlight);
      }
      textGroup.addEventListener('mouseenter', highlight);
      textGroup.addEventListener('mouseleave', unhighlight);

      const navigate = () => {
        const base = document.documentElement.dataset.base || '';
        window.location.href = `${base}/poems/${blockId}`;
      };

      if (borderGroup) borderGroup.addEventListener('click', navigate);
      textGroup.addEventListener('click', navigate);

      // Coal: анимация ромбов при hover
      if (blockId === 'coal') {
        const coalGroup = svg.querySelector('.coal-elements');
        if (coalGroup) {
          const startCoal = () => coalGroup.classList.add('animate');
          const stopCoal = () => coalGroup.classList.remove('animate');
          if (borderGroup) {
            borderGroup.addEventListener('mouseenter', startCoal);
            borderGroup.addEventListener('mouseleave', stopCoal);
          }
          textGroup.addEventListener('mouseenter', startCoal);
          textGroup.addEventListener('mouseleave', stopCoal);
        }
      }

      // Intro: анимация точек при hover
      if (blockId === 'intro') {
        const dotGroups = svg.querySelectorAll('.intro-dots, .intro-dots-mirror');
        if (dotGroups.length) {
          const startDots = () => dotGroups.forEach(g => g.classList.add('animate'));
          const stopDots = () => dotGroups.forEach(g => g.classList.remove('animate'));
          if (borderGroup) {
            borderGroup.addEventListener('mouseenter', startDots);
            borderGroup.addEventListener('mouseleave', stopDots);
          }
          textGroup.addEventListener('mouseenter', startDots);
          textGroup.addEventListener('mouseleave', stopDots);
        }
      }
    });
  });
</script>
