---
/**
 * FlowDiagram.astro — Интерактивная схема сборника
 *
 * Оригинальный SVG из Excalidraw инлайн.
 * Блок = пара <g>: border (path stroke #1e1e1e) + text.
 * Hover: подсветка рамки (drop-shadow). Клик → страница стиха.
 */
import { readFileSync } from 'fs';
import { join } from 'path';

const svgPath = join(process.cwd(), 'main_schema.svg');
const svgContent = readFileSync(svgPath, 'utf-8');
const svgBody = svgContent.replace(/<svg[^>]*>/, '').replace(/<\/svg>/, '');
---

<div class="diagram-wrapper">
  <svg
    viewBox="0 0 2433 1520"
    xmlns="http://www.w3.org/2000/svg"
    class="flow-svg"
    set:html={svgBody}
  />
</div>

<style>
  .diagram-wrapper { width: 100%; margin: 0 auto; }
  .flow-svg { width: 100%; height: auto; display: block; }

  /* Hover: только подсветка рамки, без движения */
  :global(.block-border) {
    cursor: pointer;
    transition: filter 0.2s ease;
  }
  :global(.block-border.hovered) {
    filter: drop-shadow(0 0 12px rgba(103, 65, 217, 0.65)) drop-shadow(0 0 4px rgba(103, 65, 217, 0.4));
  }
  :global(.block-text) {
    cursor: pointer;
    pointer-events: all;
  }

  /* ===== Точки Intro: анимация «стрелка» при hover ===== */
  :global(.intro-dots, .intro-dots-mirror) {
    pointer-events: none;
  }

  :global(.intro-dots .intro-dot, .intro-dots-mirror .intro-dot) {
    opacity: var(--dot-base, 0.5);
  }

  @keyframes dotFlowRight {
    0%   { translate: 0 0;      fill: #ffccd5; opacity: var(--dot-base, 0.5); }
    40%  { translate: 16px 0;   fill: #e03131; opacity: calc(var(--dot-base, 0.5) + 0.4); }
    60%  { translate: 0 0;      fill: #e03131; opacity: var(--dot-base, 0.5); }
    65%  { translate: 0 0;      fill: #ffccd5; opacity: var(--dot-base, 0.5); }
    100% { translate: 0 0;      fill: #ffccd5; opacity: var(--dot-base, 0.5); }
  }

  :global(.intro-dots.animate .intro-dot) {
    animation: dotFlowRight 2s linear infinite;
  }
  :global(.intro-dots.animate .intro-dot[data-dot="1"])  { animation-delay: 0s; }
  :global(.intro-dots.animate .intro-dot[data-dot="2"])  { animation-delay: 0.08s; }
  :global(.intro-dots.animate .intro-dot[data-dot="3"])  { animation-delay: 0.16s; }
  :global(.intro-dots.animate .intro-dot[data-dot="4"])  { animation-delay: 0.24s; }
  :global(.intro-dots.animate .intro-dot[data-dot="5"])  { animation-delay: 0.32s; }
  :global(.intro-dots.animate .intro-dot[data-dot="6"])  { animation-delay: 0.08s; }
  :global(.intro-dots.animate .intro-dot[data-dot="7"])  { animation-delay: 0.16s; }
  :global(.intro-dots.animate .intro-dot[data-dot="8"])  { animation-delay: 0.24s; }
  :global(.intro-dots.animate .intro-dot[data-dot="9"])  { animation-delay: 0.32s; }
  :global(.intro-dots.animate .intro-dot[data-dot="10"]) { animation-delay: 0.40s; }
  :global(.intro-dots.animate .intro-dot[data-dot="11"]) { animation-delay: 0.16s; }
  :global(.intro-dots.animate .intro-dot[data-dot="12"]) { animation-delay: 0.24s; }
  :global(.intro-dots.animate .intro-dot[data-dot="13"]) { animation-delay: 0.32s; }
  :global(.intro-dots.animate .intro-dot[data-dot="14"]) { animation-delay: 0.40s; }
  :global(.intro-dots.animate .intro-dot[data-dot="15"]) { animation-delay: 0.48s; }

  /* Mirror — в противоположную сторону */
  :global(.intro-dots-mirror.animate .intro-dot) {
    animation: dotFlowRight 2s linear infinite;
  }
  :global(.intro-dots-mirror.animate .intro-dot[data-dot="1"])  { animation-delay: -0.48s; }
  :global(.intro-dots-mirror.animate .intro-dot[data-dot="2"])  { animation-delay: -0.40s; }
  :global(.intro-dots-mirror.animate .intro-dot[data-dot="3"])  { animation-delay: -0.32s; }
  :global(.intro-dots-mirror.animate .intro-dot[data-dot="4"])  { animation-delay: -0.24s; }
  :global(.intro-dots-mirror.animate .intro-dot[data-dot="5"])  { animation-delay: -0.16s; }
  :global(.intro-dots-mirror.animate .intro-dot[data-dot="6"])  { animation-delay: -0.40s; }
  :global(.intro-dots-mirror.animate .intro-dot[data-dot="7"])  { animation-delay: -0.32s; }
  :global(.intro-dots-mirror.animate .intro-dot[data-dot="8"])  { animation-delay: -0.24s; }
  :global(.intro-dots-mirror.animate .intro-dot[data-dot="9"])  { animation-delay: -0.16s; }
  :global(.intro-dots-mirror.animate .intro-dot[data-dot="10"]) { animation-delay: -0.08s; }
  :global(.intro-dots-mirror.animate .intro-dot[data-dot="11"]) { animation-delay: -0.32s; }
  :global(.intro-dots-mirror.animate .intro-dot[data-dot="12"]) { animation-delay: -0.24s; }
  :global(.intro-dots-mirror.animate .intro-dot[data-dot="13"]) { animation-delay: -0.16s; }
  :global(.intro-dots-mirror.animate .intro-dot[data-dot="14"]) { animation-delay: -0.08s; }
  :global(.intro-dots-mirror.animate .intro-dot[data-dot="15"]) { animation-delay: 0s; }

  /* ===== Ромбы Coal: движение + исчезновение + возврат при hover ===== */
  :global(.coal-elements) {
    pointer-events: none;
  }
  :global(.coal-elements .coal-diamond) {
    opacity: var(--diamond-base);
  }

  @keyframes coalMove {
    /* === Cycle 1 === */
    0%   { opacity: var(--diamond-base); transform: translate(0, 0) rotate(0deg) scale(1); }
    12%  { opacity: 0; transform: translate(var(--dx), var(--dy)) rotate(var(--dr)) scale(var(--scale)); }
    14%  { opacity: 0; transform: translate(0, 0) rotate(0deg) scale(0); }
    17%  { opacity: var(--diamond-base); transform: translate(0, 0) rotate(0deg) scale(1); }
    /* === Cycle 2 === */
    25%  { opacity: var(--diamond-base); transform: translate(0, 0) rotate(0deg) scale(1); }
    37%  { opacity: 0; transform: translate(var(--dx), var(--dy)) rotate(var(--dr)) scale(var(--scale)); }
    39%  { opacity: 0; transform: translate(0, 0) rotate(0deg) scale(0); }
    42%  { opacity: var(--diamond-base); transform: translate(0, 0) rotate(0deg) scale(1); }
    /* === Cycle 3 === */
    50%  { opacity: var(--diamond-base); transform: translate(0, 0) rotate(0deg) scale(1); }
    62%  { opacity: 0; transform: translate(var(--dx), var(--dy)) rotate(var(--dr)) scale(var(--scale)); }
    64%  { opacity: 0; transform: translate(0, 0) rotate(0deg) scale(0); }
    67%  { opacity: var(--diamond-base); transform: translate(0, 0) rotate(0deg) scale(1); }
    /* === Cycle 4 === */
    75%  { opacity: var(--diamond-base); transform: translate(0, 0) rotate(0deg) scale(1); }
    87%  { opacity: 0; transform: translate(var(--dx), var(--dy)) rotate(var(--dr)) scale(var(--scale)); }
    89%  { opacity: 0; transform: translate(0, 0) rotate(0deg) scale(0); }
    92%  { opacity: var(--diamond-base); transform: translate(0, 0) rotate(0deg) scale(1); }
    100% { opacity: var(--diamond-base); transform: translate(0, 0) rotate(0deg) scale(1); }
  }

  :global(.coal-elements.animate .coal-diamond) {
    animation: coalMove 4s linear infinite;
  }
  :global(.coal-elements.animate .coal-diamond[data-diamond="1"]) { animation-delay: 0s; }
  :global(.coal-elements.animate .coal-diamond[data-diamond="2"]) { animation-delay: -0.25s; }
  :global(.coal-elements.animate .coal-diamond[data-diamond="3"]) { animation-delay: -0.5s; }
  :global(.coal-elements.animate .coal-diamond[data-diamond="4"]) { animation-delay: -0.75s; }

  /* ===== Settings: плавное появление красных/фиолетовых частиц ===== */
  :global(.settings-effects) {
    pointer-events: none;
  }

  @keyframes settingsRedPulse {
    0%   { opacity: 0; }
    10%  { opacity: var(--particle-base, 0.5); }
    30%  { opacity: var(--particle-base, 0.5); }
    40%  { opacity: 0; }
    100% { opacity: 0; }
  }
  @keyframes settingsPurplePulse {
    0%   { opacity: 0; }
    45%  { opacity: 0; }
    55%  { opacity: var(--particle-base, 0.3); }
    75%  { opacity: var(--particle-base, 0.3); }
    85%  { opacity: 0; }
    100% { opacity: 0; }
  }

  :global(.settings-effects.animate .settings-red) {
    animation: settingsRedPulse 4s linear infinite;
  }
  :global(.settings-effects.animate .settings-purple) {
    animation: settingsPurplePulse 4s linear infinite;
  }

  :global(.settings-effects.animate .settings-red[data-particle="0"])   { animation-delay: 0s; }
  :global(.settings-effects.animate .settings-red[data-particle="1"])   { animation-delay: 0.08s; }
  :global(.settings-effects.animate .settings-red[data-particle="2"])   { animation-delay: 0.16s; }
  :global(.settings-effects.animate .settings-red[data-particle="3"])   { animation-delay: 0.24s; }
  :global(.settings-effects.animate .settings-red[data-particle="4"])   { animation-delay: 0.32s; }
  :global(.settings-effects.animate .settings-red[data-particle="5"])   { animation-delay: 0.40s; }
  :global(.settings-effects.animate .settings-purple[data-particle="6"])  { animation-delay: 0s; }
  :global(.settings-effects.animate .settings-purple[data-particle="7"])  { animation-delay: 0.08s; }
  :global(.settings-effects.animate .settings-purple[data-particle="8"])  { animation-delay: 0.16s; }
  :global(.settings-effects.animate .settings-purple[data-particle="9"])  { animation-delay: 0.24s; }
  :global(.settings-effects.animate .settings-purple[data-particle="10"]) { animation-delay: 0.32s; }
  :global(.settings-effects.animate .settings-purple[data-particle="11"]) { animation-delay: 0.40s; }
  :global(.settings-effects.animate .settings-purple[data-particle="12"]) { animation-delay: 0.48s; }

  /* ===== Face id: сканирующая линия + сетка точек ===== */
  :global(.face-id-effects) {
    pointer-events: none;
  }

  @keyframes faceScanLine {
    0%   { transform: translateY(-5px); opacity: 0; }
    3%   { opacity: 0.9; }
    47%  { opacity: 0.9; }
    50%  { opacity: 0; transform: translateY(156.8px); }
    100% { opacity: 0; transform: translateY(156.8px); }
  }
  @keyframes faceDotPulse {
    0%, 18%   { opacity: var(--face-dot-base, 0.3); r: 2; }
    22%, 38%  { opacity: var(--face-dot-peak, 0.9); r: 2.5; }
    42%, 100% { opacity: var(--face-dot-base, 0.3); r: 2; }
  }

  :global(.face-id-effects.animate .face-scan-line) {
    animation: faceScanLine 3s linear infinite;
  }
  :global(.face-id-effects.animate .face-scan-line-red) {
    animation: faceScanLine 3s linear infinite;
  }
  :global(.face-id-effects.animate .face-dot) {
    animation: faceDotPulse 3s linear infinite;
  }
  :global(.face-id-effects.animate .face-dot-red) {
    --face-dot-base: 0.15;
    --face-dot-peak: 0.6;
  }

  :global(.face-id-effects.animate .face-dot[data-row="0"]) { animation-delay: 0s; }
  :global(.face-id-effects.animate .face-dot[data-row="1"]) { animation-delay: 0.6s; }
  :global(.face-id-effects.animate .face-dot[data-row="2"]) { animation-delay: 1.2s; }
  :global(.face-id-effects.animate .face-dot[data-row="3"]) { animation-delay: 1.8s; }
  :global(.face-id-effects.animate .face-dot[data-row="4"]) { animation-delay: 2.4s; }

  @keyframes lockBounceIn {
    0%   { opacity: 0; transform: scale(0.3); }
    40%  { opacity: 1; transform: scale(1.15); }
    65%  { transform: scale(0.92); }
    100% { opacity: 1; transform: scale(1); }
  }
  @keyframes shackleUnlock {
    0%   { transform: rotate(0deg) translateY(0); }
    35%  { transform: rotate(-45deg) translateY(-10px); }
    55%  { transform: rotate(-30deg) translateY(-4px); }
    75%  { transform: rotate(-38deg) translateY(-7px); }
    100% { transform: rotate(-35deg) translateY(-6px); }
  }

  :global(.face-lock-under .face-lock-group) {
    opacity: 0;
    transform: scale(0.3);
  }
  :global(.face-id-effects.unlocked ~ .face-lock-under .face-lock-group) {
    animation: lockBounceIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }
  :global(.face-lock-under .face-lock-shackle) {
    transform-origin: 0px -13px;
  }
  :global(.face-id-effects.unlocked ~ .face-lock-under .face-lock-shackle) {
    animation: shackleUnlock 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  :global(.trace-border-line) {
    stroke: #b71c1c;
    stroke-width: 3;
    stroke-dasharray: 729;
    stroke-dashoffset: 729;
    filter: drop-shadow(0 0 8px rgba(183, 28, 28, 0.8)) drop-shadow(0 0 4px rgba(183, 28, 28, 0.5));
    opacity: 0;
    transition: stroke-dashoffset 1.5s ease-in-out, opacity 0.1s ease;
  }
  :global(.trace-border-line.animate) {
    stroke-dashoffset: 0;
    opacity: 1;
  }

  @keyframes bloodDrop {
    0%   { opacity: 0; transform: translateY(-20px) scale(0.3); }
    15%  { opacity: 1; transform: translateY(2px) scale(1.15); }
    25%  { transform: translateY(0) scale(1); }
    60%  { transform: translateY(250px); }
    85%  { opacity: 1; transform: translateY(380px); }
    100% { opacity: 0; transform: translateY(420px); }
  }
  :global(.trace-blood-drop) {
    pointer-events: none;
    opacity: 0;
  }
  :global(.trace-blood-drop.animate) {
    animation: bloodDrop 1.2s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes flameFlicker {
    0%, 100% { transform: scaleY(1) scaleX(1); opacity: 0.6; }
    25%  { transform: scaleY(1.15) scaleX(0.9); opacity: 1; }
    50%  { transform: scaleY(0.85) scaleX(1.06); opacity: 0.4; }
    75%  { transform: scaleY(1.08) scaleX(0.95); opacity: 0.85; }
  }
  :global(.blaze-flames) {
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  :global(.blaze-flames.animate) {
    opacity: 1;
  }
  :global(.blaze-flame-path) {
    transform-origin: 0px 0px;
    animation: flameFlicker var(--dur, 1.5s) ease-in-out infinite;
    animation-delay: var(--d, 0s);
    filter: drop-shadow(0 0 6px rgba(224, 49, 49, 0.6)) drop-shadow(0 0 12px rgba(224, 49, 49, 0.3));
  }

  /* ===== Blue screen: трещины-паутина + грустный смайлик ===== */
  :global(.blue-screen-effects) {
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  :global(.blue-screen-effects.animate) {
    opacity: 1;
  }
  :global(.bs-crack) {
    stroke-dasharray: 500;
    stroke-dashoffset: 500;
  }
  :global(.blue-screen-effects.animate .bs-crack) {
    animation-name: crackGrow, crackGlitch;
    animation-duration: 0.5s, 1.8s;
    animation-timing-function: ease-out, step-end;
    animation-delay: var(--d, 0s), calc(var(--g, 0s) + 0.5s);
    animation-fill-mode: forwards, none;
    animation-iteration-count: 1, infinite;
  }
  :global(.blue-screen-effects.animate .bs-sad-smiley) {
    animation: smileyPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.4s forwards;
    opacity: 0;
    transform-origin: center;
  }
  @keyframes crackGrow {
    0%   { stroke-dashoffset: 500; }
    100% { stroke-dashoffset: 0; }
  }
  @keyframes crackGlitch {
    0%, 84%, 100% { transform: translate(0, 0); opacity: 0.7; filter: none; }
    2%  { transform: translate(-6px, 1px); opacity: 0.9; filter: drop-shadow(2px 0 #ff00ff) drop-shadow(-2px 0 #00ffff); }
    4%  { transform: translate(4px, -1px); opacity: 0.2; filter: none; }
    6%  { transform: translate(-2px, 2px); opacity: 0.9; filter: drop-shadow(3px 0 #ff00ff); }
    8%  { transform: translate(0, 0); opacity: 0.7; filter: none; }
    14% { transform: translate(7px, 0); opacity: 0.3; filter: drop-shadow(-3px 0 #00ffff); }
    16% { transform: translate(0, 0); opacity: 0.7; filter: none; }
    28% { transform: translate(-5px, -2px); opacity: 0.9; filter: drop-shadow(2px 0 #ff00ff) drop-shadow(-2px 0 #00ffff); }
    30% { transform: translate(0, 0); opacity: 0.7; filter: none; }
    42% { transform: translate(6px, 1px); opacity: 0.15; }
    44% { transform: translate(0, 0); opacity: 0.7; }
    58% { transform: translate(-8px, 0); opacity: 0.9; filter: drop-shadow(4px 0 #ff00ff) drop-shadow(-3px 0 #00ffff); }
    60% { transform: translate(0, 0); opacity: 0.7; filter: none; }
    72% { transform: translate(4px, -2px); opacity: 0.1; }
    74% { transform: translate(0, 0); opacity: 0.7; }
  }
  @keyframes smileyPop {
    0%   { opacity: 0; transform: scale(0.3); }
    60%  { opacity: 1; transform: scale(1.3); }
    100% { opacity: 1; transform: scale(1); }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const svg = document.querySelector('.flow-svg');
    if (!svg) return;

    const blockMap: Record<string, string> = {
      'Intro': 'intro',
      'Coal': 'coal',
      'Settings': 'settings',
      'Blaze': 'blaze',
      'Blue screen': 'blue-screen',
      'Face id': 'face-id',
      'tRace': 'trace',
      'Лаstick': 'lastick',
      'Collapse': 'collapse',
    };

    // Находим все <text> элементы
    const textEls = svg.querySelectorAll('text');

    textEls.forEach((textEl) => {
      const text = textEl.textContent?.trim() || '';
      const blockId = blockMap[text];
      if (!blockId) return;

      const textGroup = textEl.parentElement;
      if (!textGroup || textGroup.tagName !== 'g') return;

      // Ищем группу рамки — поднимаемся вверх по предыдущим sibling,
      // пока не найдём <g> со stroke-linecap="round" (рамка)
      let borderGroup: Element | null = null;
      let sibling: Element | null = textGroup.previousElementSibling;
      while (sibling) {
        if (sibling.tagName === 'g' && sibling.getAttribute('stroke-linecap') === 'round') {
          borderGroup = sibling;
          break;
        }
        sibling = sibling.previousElementSibling;
      }

      if (borderGroup) borderGroup.classList.add('block-border');
      textGroup.classList.add('block-text');

      const highlight = () => {
        if (borderGroup) borderGroup.classList.add('hovered');
      };
      const unhighlight = () => {
        if (borderGroup) borderGroup.classList.remove('hovered');
      };

      if (borderGroup) {
        borderGroup.addEventListener('mouseenter', highlight);
        borderGroup.addEventListener('mouseleave', unhighlight);
      }
      textGroup.addEventListener('mouseenter', highlight);
      textGroup.addEventListener('mouseleave', unhighlight);

      const navigate = () => {
        const base = document.documentElement.dataset.base || '';
        window.location.href = `${base}/poems/${blockId}`;
      };

      if (borderGroup) borderGroup.addEventListener('click', navigate);
      textGroup.addEventListener('click', navigate);

      // Coal: анимация ромбов при hover
      if (blockId === 'coal') {
        const coalGroup = svg.querySelector('.coal-elements');
        if (coalGroup) {
          const startCoal = () => coalGroup.classList.add('animate');
          const stopCoal = () => coalGroup.classList.remove('animate');
          if (borderGroup) {
            borderGroup.addEventListener('mouseenter', startCoal);
            borderGroup.addEventListener('mouseleave', stopCoal);
          }
          textGroup.addEventListener('mouseenter', startCoal);
          textGroup.addEventListener('mouseleave', stopCoal);
        }
      }

      // Intro: анимация точек при hover
      if (blockId === 'intro') {
        const dotGroups = svg.querySelectorAll('.intro-dots, .intro-dots-mirror');
        if (dotGroups.length) {
          const startDots = () => dotGroups.forEach(g => g.classList.add('animate'));
          const stopDots = () => dotGroups.forEach(g => g.classList.remove('animate'));
          if (borderGroup) {
            borderGroup.addEventListener('mouseenter', startDots);
            borderGroup.addEventListener('mouseleave', stopDots);
          }
          textGroup.addEventListener('mouseenter', startDots);
          textGroup.addEventListener('mouseleave', stopDots);
        }
      }

      // Settings: анимация частиц при hover
      if (blockId === 'settings') {
        const settingsGroup = svg.querySelector('.settings-effects');
        if (settingsGroup) {
          const startParticles = () => settingsGroup.classList.add('animate');
          const stopParticles = () => settingsGroup.classList.remove('animate');
          if (borderGroup) {
            borderGroup.addEventListener('mouseenter', startParticles);
            borderGroup.addEventListener('mouseleave', stopParticles);
          }
          textGroup.addEventListener('mouseenter', startParticles);
          textGroup.addEventListener('mouseleave', stopParticles);
        }
      }

      // Blaze: анимация языков пламени + лужа при hover
      if (blockId === 'blaze') {
        const blazeFlames = svg.querySelector('.blaze-flames');
        const startBlaze = () => {
          if (blazeFlames) blazeFlames.classList.add('animate');
        };
        const stopBlaze = () => {
          if (blazeFlames) blazeFlames.classList.remove('animate');
        };
        if (borderGroup) {
          borderGroup.addEventListener('mouseenter', startBlaze);
          borderGroup.addEventListener('mouseleave', stopBlaze);
        }
        textGroup.addEventListener('mouseenter', startBlaze);
        textGroup.addEventListener('mouseleave', stopBlaze);
      }

      // tRace: анимация трассировки контура + капля при hover
      if (blockId === 'trace') {
        const traceLine = svg.querySelector('.trace-border-line');
        const bloodDrop = svg.querySelector('.trace-blood-drop');
        const bloodWrapper = svg.querySelector('.trace-blood-wrapper');
        if (traceLine) {
          let dropTimer = null;

          const getTraceBorderPos = () => {
            const tr = traceLine.parentElement.getAttribute('transform');
            const m = tr.match(/translate\(([\d.]+),\s*([\d.]+)\)/);
            if (m) return { bx: parseFloat(m[1]), by: parseFloat(m[2]), bw: 235.2, bh: 156.8 };
            return { bx: 1255.79, by: 805.14, bw: 235.2, bh: 156.8 };
          };

          const startTrace = () => {
            traceLine.classList.add('animate');
            // случайная X по низу блока
            if (bloodWrapper) {
              const { bx, by, bw } = getTraceBorderPos();
              const randX = bx + Math.random() * bw;
              bloodWrapper.setAttribute('transform', `translate(${randX}, ${by + bw * 0.65 + 18})`);
            }
            dropTimer = setTimeout(() => {
              if (bloodDrop) bloodDrop.classList.add('animate');
            }, 1500);
          };
          const stopTrace = () => {
            traceLine.classList.remove('animate');
            if (bloodDrop) bloodDrop.classList.remove('animate');
            if (dropTimer) { clearTimeout(dropTimer); dropTimer = null; }
          };
          const parentGroup = traceLine.parentElement;
          if (parentGroup) {
            parentGroup.addEventListener('mouseenter', startTrace);
            parentGroup.addEventListener('mouseleave', stopTrace);
          }
          textGroup.addEventListener('mouseenter', startTrace);
          textGroup.addEventListener('mouseleave', stopTrace);
        }
      }

      // Blue screen: трещины-паутина + грустный смайлик при hover
      if (blockId === 'blue-screen') {
        const bsEffects = svg.querySelector('.blue-screen-effects');
        if (bsEffects) {
          const startCracks = () => bsEffects.classList.add('animate');
          const stopCracks = () => bsEffects.classList.remove('animate');
          if (borderGroup) {
            borderGroup.addEventListener('mouseenter', startCracks);
            borderGroup.addEventListener('mouseleave', stopCracks);
          }
          textGroup.addEventListener('mouseenter', startCracks);
          textGroup.addEventListener('mouseleave', stopCracks);
        }
      }

      // Face id: анимация сканирования + замок при hover
      if (blockId === 'face-id') {
        const faceIdGroup = svg.querySelector('.face-id-effects');
        if (faceIdGroup) {
          let lockTimer = null;
          const startScan = () => {
            faceIdGroup.classList.add('animate');
            lockTimer = setTimeout(() => {
              faceIdGroup.classList.add('unlocked');
            }, 1500);
          };
          const stopScan = () => {
            faceIdGroup.classList.remove('animate');
            faceIdGroup.classList.remove('unlocked');
            if (lockTimer) { clearTimeout(lockTimer); lockTimer = null; }
          };
          if (borderGroup) {
            borderGroup.addEventListener('mouseenter', startScan);
            borderGroup.addEventListener('mouseleave', stopScan);
          }
          textGroup.addEventListener('mouseenter', startScan);
          textGroup.addEventListener('mouseleave', stopScan);
        }
      }
    });
  });
</script>
