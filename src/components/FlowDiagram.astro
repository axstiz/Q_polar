---
/**
 * FlowDiagram.astro — Интерактивная схема сборника
 *
 * Использует оригинальный SVG из Excalidraw инлайн.
 * Блоки кликабельны → страницы стихов.
 * При наведении — glow-эффект + tooltip с превью.
 */
import { readFileSync } from 'fs';
import { join } from 'path';

// Читаем оригинальный SVG с встроенным Excalifont
const svgPath = join(process.cwd(), 'main_schema.svg');
const svgContent = readFileSync(svgPath, 'utf-8');

// Извлекаем содержимое между <svg ...> и </svg>
const svgBody = svgContent.replace(/<svg[^>]*>/, '').replace(/<\/svg>/, '');
const svgAttrs = svgContent.match(/<svg([^>]*)>/)?.[1] || '';
---

<!-- Tooltip -->
<div id="diagram-tooltip" class="tooltip"></div>

<!-- Интерактивная схема -->
<div class="diagram-wrapper">
  <svg
    viewBox="0 0 2433 1520"
    xmlns="http://www.w3.org/2000/svg"
    class="flow-svg"
    set:html={svgBody}
  />
</div>

<style>
  .diagram-wrapper {
    width: 100%;
    margin: 0 auto;
    position: relative;
  }

  .flow-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Tooltip */
  .tooltip {
    position: fixed;
    background: var(--bg);
    border: 2.5px solid var(--border);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    font-family: var(--font-handwritten);
    font-size: 1.2rem;
    color: var(--text);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
    z-index: 1000;
    max-width: 300px;
    box-shadow: 3px 3px 0 var(--border);
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .tooltip.visible {
    opacity: 1;
  }

  :global(.block-group) {
    cursor: pointer;
  }

  :global(.block-group:hover rect) {
    filter: drop-shadow(0 0 10px rgba(103, 65, 217, 0.6));
  }

  :global(.block-group text) {
    pointer-events: none;
    user-select: none;
  }
</style>

<script>
  /**
   * Интерактивность блоков схемы:
   * 1. Находим <text> элементы с названиями блоков
   * 2. Их родительские <g> делаем кликабельными
   * 3. Добавляем tooltip с превью стиха
   */

  // Карта блоков: текст → id стиха для URL
  const blockMap: Record<string, string> = {
    'Intro': 'intro',
    'Coal': 'coal',
    'Settings': 'settings',
    'Blaze': 'blaze',
    'Blue screen': 'blue-screen',
    'Face id': 'face-id',
    'tRace': 'trace',
    'Лаstick': 'lastick',
    'Collapse': 'collapse',
  };

  // Превью стихов для tooltip
  const previews: Record<string, string> = {
    'intro': 'Я на пьяном угаре рисую узоры / Сквозь темные волосы - звезды',
    'coal': 'Тряска пустых сосудов / Под оглушающий бас',
    'settings': 'Загружайся в абстракцию, дура / И вся симуляция канет под хвост',
    'blaze': 'Без контекста пустые / Слова, я закидывал',
    'blue-screen': 'Дуло, висок / Тебе кажутся выстрелы',
    'face-id': 'Мозг не источник, а интерфейс / Червоточина глубже по дням',
    'trace': 'Я боялся что выброшусь в море / Я хотел так увидеть рассвет',
    'lastick': 'Информация - бред / Ты осколками памяти',
    'collapse': 'Пустота не диагноз / А верный симптом',
  };

  document.addEventListener('DOMContentLoaded', () => {
    const tooltip = document.getElementById('diagram-tooltip');
    const svg = document.querySelector('.flow-svg');
    if (!tooltip || !svg) return;

    // Находим все <text> элементы в SVG
    const textElements = svg.querySelectorAll('text');

    textElements.forEach((textEl) => {
      const text = textEl.textContent?.trim() || '';
      const blockId = blockMap[text];
      if (!blockId) return;

      // Поднимаемся вверх по DOM до родительского <g> уровня блока
      // Ищем <g> который содержит и текст, и рамку (rect с stroke)
      let targetGroup = textEl.parentElement;
      // Поднимаемся на 1-2 уровня вверх, чтобы найти группу блока
      if (targetGroup && targetGroup.tagName === 'g') {
        targetGroup = targetGroup.parentElement || targetGroup;
      }

      if (!targetGroup) return;

      // Добавляем класс и data-атрибуты
      targetGroup.classList.add('block-group');
      targetGroup.setAttribute('data-block-id', blockId);
      targetGroup.setAttribute('data-block-title', text);
      targetGroup.style.cursor = 'pointer';

      // Hover — показываем tooltip
      targetGroup.addEventListener('mouseenter', () => {
        const rect = targetGroup!.getBoundingClientRect();
        const preview = previews[blockId] || '';
        const previewLines = preview.split('/').map(l => l.trim()).join('<br/>');
        tooltip.innerHTML = `<strong>${text}</strong><br/>${previewLines}`;
        tooltip.style.left = `${rect.left + rect.width / 2}px`;
        tooltip.style.top = `${rect.bottom + 12}px`;
        tooltip.classList.add('visible');
      });

      targetGroup.addEventListener('mouseleave', () => {
        tooltip.classList.remove('visible');
      });

      // Клик — переход на страницу стиха
      targetGroup.addEventListener('click', () => {
        const base = document.documentElement.dataset.base || '';
        window.location.href = `${base}/poems/${blockId}`;
      });

      targetGroup.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const base = document.documentElement.dataset.base || '';
          window.location.href = `${base}/poems/${blockId}`;
        }
      });
    });
  });
</script>
