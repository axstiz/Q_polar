---
import GameConsole from '../components/GameConsole.astro';
const base = import.meta.env.BASE_URL;
---
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Q-polar — интерактивный сборник стихов</title>
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
    <link rel="icon" type="image/png" href={`${base}/favicon128.png`} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="loader-overlay" id="pageLoader" aria-hidden="true">
      <div class="loader-curtain loader-curtain--top"></div>
      <div class="loader-curtain loader-curtain--bottom"></div>
      <div class="loader-spinner-wrap">
        <div class="loader-window">
          <div class="loader-spinner"></div>
          <div class="loader-label">Q</div>
        </div>
        <div class="loader-text">ЗАГРУЗКА…</div>
      </div>
    </div>

    <main class="container" style="padding: 8px; display: flex; align-items: center; justify-content: center; min-height: 100svh; box-sizing: border-box;">
      <GameConsole />
    </main>

    <style is:global>
      @import '../styles/global.css';
    </style>

    <style is:inline>
      .loader-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        overflow: hidden;
        transition: opacity 0.5s ease;
      }
      .loader-overlay.is-hiding {
        visibility: hidden;
        pointer-events: none;
      }
      .loader-curtain {
        position: absolute;
        left: 0;
        width: 100%;
        height: 51%;
        background: var(--loader-bg, #ededed);
        transition: transform 0.9s cubic-bezier(0.22, 0.61, 0.36, 1);
        will-change: transform;
      }
      .loader-curtain--top {
        top: 0;
      }
      .loader-curtain--bottom {
        bottom: 0;
      }
      .loader-overlay.is-open .loader-curtain--top { transform: translateY(-100%); }
      .loader-overlay.is-open .loader-curtain--bottom { transform: translateY(100%); }

      .loader-spinner-wrap {
        position: absolute;
        inset: 0;
        z-index: 3;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 22px;
        transition: opacity 0.4s ease, transform 0.4s ease;
      }
      .loader-overlay.is-open .loader-spinner-wrap {
        opacity: 0;
        transform: scale(0.9);
      }

      .loader-window {
        position: relative;
        width: 150px;
        height: 150px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .loader-spinner {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 14px), #000 calc(100% - 13px));
        mask: radial-gradient(farthest-side, transparent calc(100% - 14px), #000 calc(100% - 13px));
        background: conic-gradient(
          #e03131 0deg,
          #6741d9 120deg,
          #e03131 240deg,
          #6741d9 360deg
        );
        animation: loader-spin 1s linear infinite;
      }
      .loader-spinner::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: conic-gradient(
          transparent 0deg,
          #e03131 90deg,
          #6741d9 180deg,
          #e03131 270deg,
          #6741d9 360deg
        );
        -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 14px), #000 calc(100% - 13px));
        mask: radial-gradient(farthest-side, transparent calc(100% - 14px), #000 calc(100% - 13px));
      }
      @keyframes loader-spin {
        to { transform: rotate(360deg); }
      }

      .loader-label {
        font-family: 'Press Start 2P', monospace;
        font-size: 52px;
        color: #6741d9;
        text-shadow: 3px 3px 0 #e03131;
        letter-spacing: -6px;
      }
      .loader-text {
        font-family: 'Press Start 2P', monospace;
        font-size: 14px;
        color: #2d2d2d;
        letter-spacing: 1px;
      }
    </style>

    <script>
      (function () {
        const overlay = document.getElementById('pageLoader');
        if (!overlay) return;
        const MIN_MS = 2000;
        const started = Date.now();

        function reveal() {
          const elapsed = Date.now() - started;
          const wait = Math.max(0, MIN_MS - elapsed);
          setTimeout(() => {
            overlay.classList.add('is-open');
            setTimeout(() => overlay.classList.add('is-hiding'), 900);
            setTimeout(() => overlay.remove(), 1100);
          }, wait);
        }

        if (document.readyState === 'complete') {
          reveal();
        } else {
          window.addEventListener('load', reveal, { once: true });
        }
      })();
    </script>
  </body>
</html>
