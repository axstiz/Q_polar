---
/**
 * Главная страница сайта Q-polar
 *
 * Отображает интерактивную SVG-схему сборника стихов.
 * Каждый блок кликабельный и ведёт на страницу стиха.
 */
import FlowDiagram from '../components/FlowDiagram.astro';
import '../styles/global.css';

// Базовый путь для ссылок
const base = import.meta.env.BASE_URL;
---

<html lang="ru" data-base={base}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Q-polar — Интерактивный сборник стихов</title>
    <meta name="description" content="Интерактивный сборник стихов Q-polar. Навигируй по схеме, читай стихи, открывай новые пути." />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <main class="container">
      <!-- Заголовок сайта -->
      <header class="site-header">
        <h1 class="site-title">Q-polar</h1>
        <p class="site-subtitle">Интерактивный сборник стихов</p>
      </header>

      <!-- Интерактивная схема -->
      <FlowDiagram />

      <!-- Инструкция -->
      <p class="hint">
        Наведи на блок, чтобы увидеть превью. Нажми, чтобы перейти к стиху.
      </p>
    </main>

    <style>
      /* Шапка сайта */
      .site-header {
        text-align: center;
        margin-bottom: 2rem;
      }

      .site-title {
        font-size: 4rem;
        color: var(--accent-blue);
        letter-spacing: 0.05em;
      }

      .site-subtitle {
        font-family: var(--font-handwritten);
        font-size: 1.4rem;
        color: var(--text);
        opacity: 0.6;
        margin-top: 0.5rem;
      }

      /* Подсказка внизу */
      .hint {
        text-align: center;
        font-family: var(--font-handwritten);
        font-size: 1.2rem;
        color: var(--text);
        opacity: 0.5;
        margin-top: 2rem;
      }
    </style>
  </body>
</html>
