---
import GameConsole from '../components/GameConsole.astro';
const base = import.meta.env.BASE_URL;
---
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Q-polar — интерактивный сборник стихов</title>
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
    <link rel="icon" type="image/png" href={`${base}/favicon128.png`} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Permanent+Marker&display=swap" rel="stylesheet" />
  </head>
  <body>
    <svg class="bg-pattern" id="bgPattern" aria-hidden="true"></svg>

    <div class="loader-overlay" id="pageLoader" aria-hidden="true">
      <div class="loader-curtain loader-curtain--top"></div>
      <div class="loader-curtain loader-curtain--bottom"></div>
      <div class="loader-spinner-wrap">
        <div class="loader-window">
          <div class="loader-spinner"></div>
          <div class="loader-label">Q</div>
        </div>
        <div class="loader-text">ЗАГРУЗКА…</div>
      </div>
    </div>

    <main class="container" style="padding: 8px; display: flex; align-items: center; justify-content: center; min-height: 100svh; box-sizing: border-box;">
      <GameConsole />
    </main>

    <style is:global>
      @import '../styles/global.css';
    </style>

    <style is:inline>
      .bg-pattern {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        pointer-events: none;
        overflow: hidden;
      }
      .loader-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        overflow: hidden;
        transition: opacity 0.5s ease;
      }
      .loader-overlay.is-hiding {
        visibility: hidden;
        pointer-events: none;
      }
      .loader-curtain {
        position: absolute;
        left: 0;
        width: 100%;
        height: 51%;
        background: var(--loader-bg, #ededed);
        transition: transform 0.9s cubic-bezier(0.22, 0.61, 0.36, 1);
        will-change: transform;
      }
      .loader-curtain--top {
        top: 0;
      }
      .loader-curtain--bottom {
        bottom: 0;
      }
      .loader-overlay.is-open .loader-curtain--top { transform: translateY(-100%); }
      .loader-overlay.is-open .loader-curtain--bottom { transform: translateY(100%); }

      .loader-spinner-wrap {
        position: absolute;
        inset: 0;
        z-index: 3;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 22px;
        transition: opacity 0.4s ease, transform 0.4s ease;
      }
      .loader-overlay.is-open .loader-spinner-wrap {
        opacity: 0;
        transform: scale(0.9);
      }

      .loader-window {
        position: relative;
        width: 150px;
        height: 150px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .loader-spinner {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 14px), #000 calc(100% - 13px));
        mask: radial-gradient(farthest-side, transparent calc(100% - 14px), #000 calc(100% - 13px));
        background: conic-gradient(
          #e03131 0deg,
          #6741d9 120deg,
          #e03131 240deg,
          #6741d9 360deg
        );
        animation: loader-spin 1s linear infinite;
      }
      .loader-spinner::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: conic-gradient(
          transparent 0deg,
          #e03131 90deg,
          #6741d9 180deg,
          #e03131 270deg,
          #6741d9 360deg
        );
        -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 14px), #000 calc(100% - 13px));
        mask: radial-gradient(farthest-side, transparent calc(100% - 14px), #000 calc(100% - 13px));
      }
      @keyframes loader-spin {
        to { transform: rotate(360deg); }
      }

      .loader-label {
        font-family: 'Press Start 2P', monospace;
        font-size: 52px;
        color: #6741d9;
        text-shadow: 3px 3px 0 #e03131;
        letter-spacing: -6px;
      }
      .loader-text {
        font-family: 'Press Start 2P', monospace;
        font-size: 14px;
        color: #2d2d2d;
        letter-spacing: 1px;
      }
    </style>

    <script>
      (function () {
        const overlay = document.getElementById('pageLoader');
        if (!overlay) return;
        const MIN_MS = 500;
        const started = Date.now();

        function reveal() {
          const elapsed = Date.now() - started;
          const wait = Math.max(0, MIN_MS - elapsed);
          setTimeout(() => {
            overlay.classList.add('is-open');
            setTimeout(() => overlay.classList.add('is-hiding'), 900);
            setTimeout(() => overlay.remove(), 1100);
          }, wait);
        }

        if (document.readyState === 'complete') {
          reveal();
        } else {
          window.addEventListener('load', reveal, { once: true });
        }
      })();
    </script>
    <script>
      (function () {
        const svg = document.getElementById('bgPattern');
        const gc = document.getElementById('gc');
        if (!svg || !gc) return;
        const NS = 'http://www.w3.org/2000/svg';
        const GRAD = ['#e03131', '#9775fa', '#6741d9'];

        function paint() {
          const W = Math.max(1, window.innerWidth);
          const H = Math.max(1, window.innerHeight);
          svg.setAttribute('width', W);
          svg.setAttribute('height', H);
          svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);
          svg.textContent = '';

          const defs = document.createElementNS(NS, 'defs');
          const lg = document.createElementNS(NS, 'linearGradient');
          lg.id = 'bp-grad';
          lg.setAttribute('x1', '0');
          lg.setAttribute('y1', '0');
          lg.setAttribute('x2', '1');
          lg.setAttribute('y2', '1');
          [['0', GRAD[0]], ['0.55', GRAD[1]], ['1', GRAD[2]]].forEach(function (st) {
            const s = document.createElementNS(NS, 'stop');
            s.setAttribute('offset', st[0]);
            s.setAttribute('stop-color', st[1]);
            lg.appendChild(s);
          });
          defs.appendChild(lg);
          svg.appendChild(defs);

          const r = gc.getBoundingClientRect();
          const baseW = Math.max(r.width, 1);
          const baseH = Math.max(r.height, 1);
          const baseR = Math.min(baseW, baseH) * 0.22;

          let expand = 14;
          let step = 14;
          const GROW = 1.12;
          while (expand <= W) {
            const x = r.left - expand;
            const y = r.top - expand;
            const w = baseW + expand * 2;
            const h = baseH + expand * 2;
            if (w <= 0 || h <= 0) continue;
            const t = expand / W;
            const opacity = 0.5 * (1 - t);
            if (opacity <= 0.02) break;
            const rect = document.createElementNS(NS, 'rect');
            rect.setAttribute('x', x);
            rect.setAttribute('y', y);
            rect.setAttribute('width', w);
            rect.setAttribute('height', h);
            rect.setAttribute('rx', baseR * (w / baseW));
            rect.setAttribute('fill', 'none');
            rect.setAttribute('stroke', 'url(#bp-grad)');
            rect.setAttribute('stroke-width', '2');
            rect.setAttribute('stroke-dasharray', (10 + expand * 0.04).toFixed(1) + ' ' + (22 + expand * 0.22).toFixed(1));
            rect.setAttribute('stroke-linecap', 'round');
            rect.setAttribute('opacity', opacity.toFixed(3));
            svg.appendChild(rect);

            expand += step;
            step *= GROW;
          }
        }

        paint();
        window.addEventListener('resize', paint);
        window.addEventListener('orientationchange', paint);
      })();
    </script>
  </body>
</html>
