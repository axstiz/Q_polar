---
import GameConsole from '../components/GameConsole.astro';
const base = import.meta.env.BASE_URL;
---
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Q-polar — интерактивный сборник стихов</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <main class="container" style="padding: 8px; display: flex; align-items: center; justify-content: center; min-height: 100svh; box-sizing: border-box;">
      <GameConsole />
    </main>

    <style is:global>
      @import '../styles/global.css';
    </style>
  </body>
</html>
