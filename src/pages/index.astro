---
/**
 * Главная страница сайта Q-polar
 *
 * Отображает интерактивную SVG-схему сборника стихов.
 * Каждый блок кликабельный и ведёт на страницу стиха.
 */
import FlowDiagram from '../components/FlowDiagram.astro';
import '../styles/global.css';

// Базовый путь для ссылок
const base = import.meta.env.BASE_URL;
---

<html lang="ru" data-base={base}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Q-polar — Интерактивный сборник стихов</title>
    <meta name="description" content="Интерактивный сборник стихов Q-polar. Навигируй по схеме, читай стихи, открывай новые пути." />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <main class="container">
      <!-- Интерактивная схема -->
      <FlowDiagram />
    </main>
  </body>
</html>
