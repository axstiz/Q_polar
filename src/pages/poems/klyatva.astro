---
/**
 * Страница стиха "Клятва экзоскелета"
 * Bonus: ведёт в Blaze
 */
import PoemLayout from '../../layouts/PoemLayout.astro';
import { getPoem, getNextPoems, getPrevPoems } from '../../data/poems';

const poem = getPoem('klyatva-exo')!;
const nextPoems = getNextPoems('klyatva-exo').map(p => ({ title: p.title, slug: p.slug }));
const prevPoems = getPrevPoems('klyatva-exo').map(p => ({ title: p.title, slug: p.slug }));
---

<PoemLayout
  title={poem.title}
  lines={poem.lines}
  prevPoems={prevPoems}
  nextPoems={nextPoems}
  branch={poem.branch}
/>
