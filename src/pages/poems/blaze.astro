---
/**
 * Страница стиха "Blaze"
 * Верхняя ветка: Settings → Blaze → Blue screen
 */
import PoemLayout from '../../layouts/PoemLayout.astro';
import { getPoem, getNextPoems, getPrevPoems } from '../../data/poems';

const poem = getPoem('blaze')!;
const nextPoems = getNextPoems('blaze').map(p => ({ title: p.title, slug: p.slug }));
const prevPoems = getPrevPoems('blaze').map(p => ({ title: p.title, slug: p.slug }));
---

<PoemLayout
  title={poem.title}
  lines={poem.lines}
  prevPoems={prevPoems}
  nextPoems={nextPoems}
  branch={poem.branch}
/>
