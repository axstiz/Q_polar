---
/**
 * Страница стиха "Lastick"
 * Нижняя ветка: tRase → Lastick → Collapse
 */
import PoemLayout from '../../layouts/PoemLayout.astro';
import { getPoem, getNextPoems, getPrevPoems } from '../../data/poems';

const poem = getPoem('lastick')!;
const nextPoems = getNextPoems('lastick').map(p => ({ title: p.title, slug: p.slug }));
const prevPoems = getPrevPoems('lastick').map(p => ({ title: p.title, slug: p.slug }));
---

<PoemLayout
  title={poem.title}
  lines={poem.lines}
  prevPoems={prevPoems}
  nextPoems={nextPoems}
  branch={poem.branch}
/>
