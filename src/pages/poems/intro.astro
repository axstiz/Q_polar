---
/**
 * Страница стиха "Intro"
 * Начальный блок схемы, ведёт в Coal
 */
import PoemLayout from '../../layouts/PoemLayout.astro';
import { getPoem, getNextPoems, getPrevPoems } from '../../data/poems';

const poem = getPoem('intro')!;
const nextPoems = getNextPoems('intro').map(p => ({ title: p.title, slug: p.slug }));
const prevPoems = getPrevPoems('intro').map(p => ({ title: p.title, slug: p.slug }));
---

<PoemLayout
  title={poem.title}
  lines={poem.lines}
  prevPoems={prevPoems}
  nextPoems={nextPoems}
  hologramId={poem.id}
  branch={poem.branch}
/>
