---
/**
 * Страница стиха "Coal"
 * Хаб: ведёт в Settings (верхняя ветка) и Face id (нижняя ветка)
 */
import PoemLayout from '../../layouts/PoemLayout.astro';
import { getPoem, getNextPoems, getPrevPoems } from '../../data/poems';

const poem = getPoem('coal')!;
const nextPoems = getNextPoems('coal').map(p => ({ title: p.title, slug: p.slug }));
const prevPoems = getPrevPoems('coal').map(p => ({ title: p.title, slug: p.slug }));
---

<PoemLayout
  title={poem.title}
  lines={poem.lines}
  prevPoems={prevPoems}
  nextPoems={nextPoems}
  branch={poem.branch}
/>
